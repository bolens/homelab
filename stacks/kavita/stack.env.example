# Kavita – copy to stack.env. Set PUID/PGID to match host if using bind-mounted libraries.
# Docs: https://docs.linuxserver.io/images/docker-kavita

# Optional: user/group for file ownership (default 1000)
# PUID=1000
# PGID=1000

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Library bind mounts (host → /data/... in container)
KAVITA_BOOKS_PATH=/path/to/media/books
KAVITA_CALIBRE_EXPORT_PATH=/path/to/media/kavita-books
KAVITA_COMICS_PATH=/path/to/media/comics
KAVITA_MANGA_PATH=/path/to/media/manga

# Optional experimental independent-provider override. These files stay outside Git.
# Generate a shared key of at least 32 characters. Hardcover may be an empty file
# until configured; a catalog token is never used for personal reading updates.
# KAVITA_PROVIDER_KEY_PATH=/path/to/private/kavita/provider_key
# KAVITA_HARDCOVER_TOKEN_PATH=/path/to/private/kavita/hardcover_token
# AniList, MAL and other personal tokens are entered separately for each Kavita user.
# Optional OAuth: fixed public Kavita origin and private registered-client JSON.
# Blank clients in the shipped example keep account onboarding disabled.
# KAVITA_PUBLIC_URL=https://kavita.yourdomain.com
# KAVITA_OAUTH_CLIENTS_PATH=/path/to/private/kavita/oauth-clients.json

# The independent runtime saves its signed creation snapshot in the existing /config volume.
# Cache and receipt limits are fixed in the image; protected capacity exhaustion holds writes.

# Optional CI images for the explicit provider override. Prefer matching commit tags.
# KAVITA_INDEPENDENT_IMAGE=ghcr.io/bolens/homelab-kavita-independent:sha-<commit>
# KAVITA_PROVIDERS_IMAGE=ghcr.io/bolens/homelab-kavita-providers:sha-<commit>
