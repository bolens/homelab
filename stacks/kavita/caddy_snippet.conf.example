# Kavita — split-horizon + public TLS: kavita.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

kavita.home, kavita.local {
	tls internal
	reverse_proxy kavita:5000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://kavita.example.com {
	reverse_proxy kavita:5000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

kavita.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy kavita:5000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
