# Converted tagging uses the existing primary-key Mylar API and authenticated monitor; no new ingress.
# Optional DDL discovery uses existing authenticated settings; Requests remains default and owns archive transfers.
# Mylar3 — split-horizon + public TLS: mylar3.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).
# Activity, workflow and backend settings use the existing authenticated Mylar application routes.

mylar3.home, mylar3.local {
	tls internal
	reverse_proxy mylar3:8090 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://mylar3.example.com {
	reverse_proxy mylar3:8090 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

mylar3.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy mylar3:8090 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
