# Mylar3 — split-horizon + public TLS: mylar3.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

mylar3.home, mylar3.local {
	tls internal
	reverse_proxy mylar3:8090 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://mylar3.example.com {
	reverse_proxy mylar3:8090 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

mylar3.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy mylar3:8090 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
