{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --filter @asking-ng/contracts run build && vp exec tsc",
    "start": "node dist/index.js",
    "dev": "vp exec nodemon --watch src --ext ts --exec tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "vp lint && pnpm run lint:boundaries",
    "lint:boundaries": "node ./scripts/check-route-boundaries.mjs",
    "contracts:snapshot": "node ./scripts/contract-snapshot.mjs",
    "perf:baseline": "node ./scripts/perf-baseline.mjs",
    "slo:smoke": "node ./scripts/slo-smoke.mjs",
    "read-model:reconcile-smoke": "node ./scripts/read-model-reconcile-smoke.mjs",
    "typecheck": "vp exec tsc --noEmit",
    "knip": "vp exec knip",
    "verify": "pnpm run lint && pnpm run knip && pnpm run typecheck && pnpm run test:coverage && pnpm run build"
  },
  "dependencies": {
    "@asking-ng/contracts": "workspace:*",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/under-pressure": "^9.0.3",
    "bcryptjs": "^3.0.3",
    "envalid": "^8.1.1",
    "fastify": "^5.8.5",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "@polar-sh/sdk": "^0.40.0",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "pino": "^9.14.0",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.2",
    "ws": "^8.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "catalog:",
    "knip": "^6.4.1",
    "nodemon": "^3.1.11",
    "oxlint": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
