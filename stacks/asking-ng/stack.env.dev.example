# asking-ng dev/script envs — optional local helper file.
# Copy to `stack.env.dev` when running API utility scripts and local smoke checks.
#
# This file is intentionally separate from `stack.env.example` so deploy/runtime
# variables stay concise.

# =========================
# Contract snapshot script inputs
# =========================
# Used by `pnpm run contracts:snapshot` from stacks/asking-ng/api.
# CONTRACT_SNAPSHOT_POLL_ID=REPLACE_WITH_EXISTING_POLL_ID
# CONTRACT_SNAPSHOT_AUTH_BEARER=REPLACE_WITH_OPTIONAL_JWT_BEARER
# CONTRACT_SNAPSHOT_OUT_DIR=./artifacts/contracts

# =========================
# Perf baseline script inputs
# =========================
# Used by `pnpm run perf:baseline` from stacks/asking-ng/api.
# PERF_BASELINE_POLL_ID=REPLACE_WITH_EXISTING_POLL_ID
# PERF_BASELINE_VOTE_BODY={"option":"A"}
# PERF_BASELINE_ITERATIONS=20
# PERF_BASELINE_WARMUP=3
# PERF_BASELINE_OUT_DIR=./artifacts/perf

# =========================
# SLO smoke script inputs
# =========================
# Used by `pnpm run slo:smoke` from stacks/asking-ng/api.
# SLO_SMOKE_BASE_URL=http://127.0.0.1:18081
# SLO_SMOKE_POLL_ID=REPLACE_WITH_EXISTING_POLL_ID
# SLO_SMOKE_ITERATIONS=20
# SLO_SMOKE_WARMUP=3
# SLO_SMOKE_P95_BUDGET_MS=250
# SLO_SMOKE_SUCCESS_RATE_PCT=99
# SLO_SMOKE_OUT_DIR=./artifacts/slo
# SLO_SMOKE_BOOTSTRAP_POLL=true
# SLO_SMOKE_CLEANUP_BOOTSTRAP=true

# =========================
# Read-model reconcile smoke inputs
# =========================
# Used by `pnpm run read-model:reconcile-smoke` from stacks/asking-ng/api.
# RECONCILE_SMOKE_BASE_URL=http://127.0.0.1:18081
# RECONCILE_SMOKE_ADMIN_TOKEN=REPLACE_WITH_ADMIN_TOKEN
# RECONCILE_SMOKE_LIMIT=100
# RECONCILE_SMOKE_DIFF_THRESHOLD=0
# RECONCILE_SMOKE_FAIL_ON_ALERT=true
# RECONCILE_SMOKE_OUT_DIR=./artifacts/reconcile

# =========================
# Monitoring smoke check (repo root)
# =========================
# Used by `bash scripts/monitoring-smoke-check.sh` from the docker repo root.
# LOKI_CONTAINER=loki
# LOKI_QUERY_WINDOW=15m
# LOKI_ENFORCE_THRESHOLDS=0
# LOKI_FALLBACK_THRESHOLD=20
# LOKI_RECONCILE_THRESHOLD=0
# LOKI_HTTP_5XX_THRESHOLD=10
# LOKI_LLM_UPSTREAM_THRESHOLD=5
