# asking-ng — frontend on /, API on /api (path stripped for Express)
# Replace asking-ng.example.com with your hostname.

asking-ng.home, asking-ng.local {
	tls internal
	handle_path /api/* {
		reverse_proxy asking-ng-api:3001
	}
	handle {
		reverse_proxy asking-ng-frontend:3000 {
			header_up X-Forwarded-Proto https
		}
	}
}

http://asking-ng.example.com {
	handle_path /api/* {
		reverse_proxy asking-ng-api:3001
	}
	handle {
		reverse_proxy asking-ng-frontend:3000 {
			header_up X-Forwarded-Proto https
		}
	}
}

asking-ng.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	handle_path /api/* {
		reverse_proxy asking-ng-api:3001
	}
	handle {
		reverse_proxy asking-ng-frontend:3000 {
			header_up X-Forwarded-Proto https
		}
	}
}
