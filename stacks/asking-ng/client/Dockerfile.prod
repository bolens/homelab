# syntax=docker/dockerfile:1
# Match api/Dockerfile base so BuildKit can reuse shared Node layers.
FROM node:22-alpine AS build

WORKDIR /workspace
ENV PATH=/workspace/client/node_modules/.bin:/workspace/node_modules/.bin:$PATH

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY client/package.json client/
COPY api/package.json api/
COPY packages/contracts/package.json packages/contracts/

COPY packages/contracts/tsconfig.json packages/contracts/
COPY packages/contracts/src packages/contracts/src

RUN --mount=type=cache,id=asking-ng-pnpm,target=/pnpm/store \
  corepack enable pnpm \
  && pnpm install --frozen-lockfile --filter client... --store-dir=/pnpm/store

WORKDIR /workspace/client
COPY client/ ./

ARG VITE_API_BASE=/api
ENV VITE_API_BASE=$VITE_API_BASE

ARG VITE_PUBLIC_ORIGIN=
ENV VITE_PUBLIC_ORIGIN=$VITE_PUBLIC_ORIGIN

ARG VITE_STREAMING_OBS_DOC_URL=
ENV VITE_STREAMING_OBS_DOC_URL=$VITE_STREAMING_OBS_DOC_URL

ARG VITE_SITE_FOOTER=
ENV VITE_SITE_FOOTER=$VITE_SITE_FOOTER

ARG VITE_ATTRIBUTION_URL=
ENV VITE_ATTRIBUTION_URL=$VITE_ATTRIBUTION_URL

ARG VITE_UMAMI_SCRIPT_URL=
ENV VITE_UMAMI_SCRIPT_URL=$VITE_UMAMI_SCRIPT_URL

ARG VITE_UMAMI_WEBSITE_ID=
ENV VITE_UMAMI_WEBSITE_ID=$VITE_UMAMI_WEBSITE_ID

ARG VITE_UMAMI_DOMAINS=
ENV VITE_UMAMI_DOMAINS=$VITE_UMAMI_DOMAINS

ARG VITE_PLAUSIBLE_SCRIPT_URL=
ENV VITE_PLAUSIBLE_SCRIPT_URL=$VITE_PLAUSIBLE_SCRIPT_URL

ARG VITE_PLAUSIBLE_DOMAIN=
ENV VITE_PLAUSIBLE_DOMAIN=$VITE_PLAUSIBLE_DOMAIN

ARG VITE_MATOMO_BASE_URL=
ENV VITE_MATOMO_BASE_URL=$VITE_MATOMO_BASE_URL

ARG VITE_MATOMO_SITE_ID=
ENV VITE_MATOMO_SITE_ID=$VITE_MATOMO_SITE_ID

ARG VITE_LEGAL_CONTACT_EMAIL=
ENV VITE_LEGAL_CONTACT_EMAIL=$VITE_LEGAL_CONTACT_EMAIL

ARG VITE_LEGAL_CONTACT_URL=
ENV VITE_LEGAL_CONTACT_URL=$VITE_LEGAL_CONTACT_URL

ARG VITE_LEGAL_JURISDICTION=
ENV VITE_LEGAL_JURISDICTION=$VITE_LEGAL_JURISDICTION

ARG VITE_LEGAL_LAST_UPDATED=
ENV VITE_LEGAL_LAST_UPDATED=$VITE_LEGAL_LAST_UPDATED

ARG VITE_LEGAL_SECURITY_EMAIL=
ENV VITE_LEGAL_SECURITY_EMAIL=$VITE_LEGAL_SECURITY_EMAIL

RUN pnpm run build

FROM caddy:2-alpine

COPY --from=build /workspace/client/build /srv
COPY client/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
