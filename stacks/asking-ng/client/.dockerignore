# Reinstalled inside the image; excluding avoids huge build context.
node_modules

# Produced by local `vp build` / `vite build`; image runs a clean build.
build
dist

# Test / coverage output (not used in the production image)
coverage
test-results
playwright-report

# Playwright specs and local e2e config — not part of the static build
e2e

# Git and editor metadata
.git
.gitignore
.vscode
.idea

# Local secrets and env (build uses ARG/ENV in Dockerfile)
.env
.env.*

# Logs and caches
*.log
npm-debug.log*
.pnpm-store
.vite

# Dev-only image recipe
Dockerfile.dev
