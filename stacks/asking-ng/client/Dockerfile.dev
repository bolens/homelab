# use Node.js 20 (LTS) as base image for compatibility
FROM node:20-alpine

RUN apk add --no-cache wget

WORKDIR /workspace
ENV PATH=/workspace/client/node_modules/.bin:/workspace/node_modules/.bin:$PATH

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY client/package.json client/
COPY api/package.json api/
COPY packages/contracts/package.json packages/contracts/
COPY packages/contracts/tsconfig.json packages/contracts/
COPY packages/contracts/src packages/contracts/src

RUN corepack enable pnpm \
  && pnpm install --frozen-lockfile --filter client...

WORKDIR /workspace/client
COPY client/ ./

ARG VITE_API_BASE=/api
ENV VITE_API_BASE=$VITE_API_BASE

CMD ["sh", "-c", "pnpm --filter @asking-ng/contracts run build && vp dev"]
