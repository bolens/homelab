# Wait 3 days before newly published versions are eligible.
minimum-release-age=4320
# Oxlint platform bindings can publish inside the age gate window; exclude so installs keep working.
minimum-release-age-exclude=@oxlint/binding-*

# Keep installs deterministic in CI and local workflows.
prefer-frozen-lockfile=true
shared-workspace-lockfile=true

# Prefer local workspace packages when available.
prefer-workspace-packages=true

# Central pnpm content-addressable store for this repo.
store-dir=../../.pnpm-home/store/v10
