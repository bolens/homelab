{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "separateMajorMinor": true,
  "timezone": "America/Denver",
  "minimumReleaseAge": "3 days",
  "schedule": ["before 6am on monday"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "automerge": true,
    "automergeType": "pr",
    "requiredStatusChecks": [
      "asking-ng api / verify",
      "asking-ng client / verify",
      "asking-ng docker / integration"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "groupName": "non-major npm dependencies",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "matchManagers": ["npm"],
      "groupName": "major npm dependencies",
      "matchUpdateTypes": ["major"]
    },
    {
      "matchFileNames": ["pnpm-lock.yaml"],
      "groupName": "pnpm lockfile maintenance",
      "automerge": true,
      "automergeType": "pr",
      "requiredStatusChecks": [
        "asking-ng api / verify",
        "asking-ng client / verify",
        "asking-ng docker / integration"
      ]
    },
    {
      "matchPackageNames": ["node", "pnpm"],
      "enabled": false
    }
  ]
}
