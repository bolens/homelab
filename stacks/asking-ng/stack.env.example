# asking-ng — copy to stack.env and set strong secrets.
# UX tip: configure in order (required -> hardening -> optional features).
# TZ/locale: optional shared.env when deployed from homelab-user/homelab stacks.

# =========================
# Optional debug host port
# =========================
# Production/default compose keeps asking-ng-api internal-only (no host binding).
# For local host curl/smoke checks, use the debug override:
#   docker compose -f docker-compose.yml -f docker-compose.debug.yml up -d --build
# Optional override (default 8080):
# ASKING_NG_API_HOST_PORT=18081

# =========================
# Required for first start
# =========================

# Postgres
POSTGRES_DB=asking
POSTGRES_USER=asking
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD

# =========================
# Build-time frontend config
# =========================

# Frontend API base path is baked at **image build** time (Dockerfile default: /api).
# Override only when building: docker compose build --build-arg VITE_API_BASE=/api
# (must match Caddy handle_path for /api).

# Public browser origin (no trailing slash), baked at **client image build** for absolute
# Open Graph / Twitter preview image URLs. Example: https://asking-ng.example.com
# VITE_PUBLIC_ORIGIN=https://asking-ng.example.com

# Optional: URL for the in-app “OBS / browser source” documentation link (My Polls, Poll owner kit,
# Home post-create, Developer). Defaults to the upstream GitHub doc; set to your fork or internal wiki.
# VITE_STREAMING_OBS_DOC_URL=https://example.com/docs/streaming-obs

# Site footer (baked at **client image build**): empty or `default` = “Powered by asking-ng” + link;
# `hidden` / `none` / `off` = no footer; any other string = plain-text footer (max 280 chars, whitelabel credit).
# VITE_SITE_FOOTER=hidden
# Optional URL for that default link (`https:` only, or `http://localhost…` for dev). Defaults to upstream asking on GitHub.
# VITE_ATTRIBUTION_URL=https://github.com/jdleo/asking
# Optional Umami analytics (baked at **client image build**). To enable, set both:
# VITE_UMAMI_SCRIPT_URL=https://umami.example.com/script.js
# VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# Optional: restrict analytics to specific hostnames (comma-separated)
# VITE_UMAMI_DOMAINS=asking-ng.example.com
# Optional Plausible analytics (baked at **client image build**):
# VITE_PLAUSIBLE_SCRIPT_URL=https://plausible.example.com/js/script.js
# VITE_PLAUSIBLE_DOMAIN=asking-ng.example.com
# Optional Matomo analytics (baked at **client image build**):
# VITE_MATOMO_BASE_URL=https://matomo.example.com
# VITE_MATOMO_SITE_ID=1

# Optional: legal contact & governing law (baked at **client image build**), shown on `/terms` and `/privacy`.
# VITE_LEGAL_CONTACT_EMAIL=abuse@example.com
# VITE_LEGAL_CONTACT_URL=https://example.com/contact
# VITE_LEGAL_JURISDICTION=Your region or country (e.g. State of California, USA)
# VITE_LEGAL_LAST_UPDATED=2026-04-15
# VITE_LEGAL_SECURITY_EMAIL=security@example.com

# Optional Playwright admin login test: same value as ADMIN_TOKEN (local: export E2E_ADMIN_TOKEN=...).
# CI: set repository secret E2E_ADMIN_TOKEN if you want the admin e2e to run (skipped when unset).

# JWT for user sessions (`/auth/login`, Bearer token on `/profile`, `/users`, …). Required in production (API exits if unset/default when NODE_ENV=production).
# Generate: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_64
# The API container image sets NODE_ENV=production so JWT_SECRET is validated at startup. Local `pnpm dev` leaves NODE_ENV unset unless you export it.

# Admin UI (/admin/*) — sent as `x-admin-token` on admin API requests; required for admin routes.
# Superadmin via admin token: only while zero superadmins exist (bootstrap); then use a superadmin JWT on POST/PATCH /users.
# Generate a new value (pick one), paste the single-line output as ADMIN_TOKEN:
#   openssl rand -base64 48 | tr -d '\n'
#   openssl rand -hex 32
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# =========================
# Production hardening
# =========================

# Sequelize `sync({ alter })` — off in production by default. Set SEQUELIZE_SYNC_ALTER=true only when you intentionally want ALTER during sync (not recommended for stable deploys).
# SEQUELIZE_SYNC_ALTER=true

# Session JWT validation: short TTL in-memory cache for active users (ms). Default 2000. Mutations invalidate the affected user.
# SESSION_CACHE_TTL_MS=2000

# Global HTTP rate limiting (Fastify): requests per window (all API routes).
# HTTP_RATE_LIMIT_MAX=300
# HTTP_RATE_LIMIT_WINDOW_MS=60000

# Cookie banner: public GET /telemetry/consent-region (no raw country in JSON). Without a geo header (e.g. local dev) the client sees `unknown`.
# Optional override for QA or non-CDN deployments: `eu` (granular UI default) or `non-eu` (simple UI default).
# FORCE_CONSENT_REGION=eu
# Lowercase HTTP header name the API reads for ISO country (default Cloudflare `cf-ipcountry`).
# CONSENT_COUNTRY_HEADER=cf-ipcountry

# Backpressure guard (`@fastify/under-pressure`) to shed load before hard failure.
# Event loop delay threshold (ms) before 503 pressure responses.
# PRESSURE_MAX_EVENT_LOOP_DELAY_MS=1000
# Optional memory ceilings (bytes). Leave unset/0 to disable memory-based shedding.
# PRESSURE_MAX_HEAP_USED_BYTES=0
# PRESSURE_MAX_RSS_BYTES=0
# Optional Prometheus scrape endpoint at GET /metrics (disabled by default).
# ENABLE_PROMETHEUS_METRICS=true

# Optional self-hosted notification sink (ntfy/Gotify/Matrix bridge/webhook adapter).
# NOTIFY_WEBHOOK_URL=https://notify.example.com/hooks/asking-ng
# NOTIFY_WEBHOOK_TOKEN=REPLACE_WITH_RANDOM_SECRET
# Optional external audit sink (Loki/OpenSearch adapter, SIEM, etc).
# AUDIT_LOG_SINK_URL=https://audit.example.com/ingest
# AUDIT_LOG_SINK_TOKEN=REPLACE_WITH_RANDOM_SECRET
# Optional Sentry-compatible error sink endpoint (self-hosted relay/webhook adapter).
# SENTRY_COMPAT_WEBHOOK_URL=https://errors.example.com/ingest
# SENTRY_COMPAT_WEBHOOK_TOKEN=REPLACE_WITH_RANDOM_SECRET
# Outbound integration timeout (ms) for all webhook sinks.
# INTEGRATION_WEBHOOK_TIMEOUT_MS=5000
# Circuit breaker opens per sink after N consecutive failures.
# INTEGRATION_CIRCUIT_BREAKER_THRESHOLD=5
# Cooldown while breaker is open (ms).
# INTEGRATION_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# Production: GET /info returns only `{ "service" }` unless you opt in to version/node/commit details.
# EXPOSE_SERVICE_INFO_DETAILS=true

# Production: GET /llm/status omits provider base URLs unless opted in.
# LLM_EXPOSE_PUBLIC_DETAILS=true

# Swagger UI at /api-docs — disabled in production unless true.
# ENABLE_API_DOCS=true

# Default locale for poll integration webhook `command_hints` / `hint_packs` primary strings (`en`, `en-gb`, `es`).
# Receivers always get `hint_packs` with all supported locales; this only selects the default top-level hints + `hint_locale`.
# POLL_WEBHOOK_HINT_LOCALE=en

# Async job runner for non-blocking side effects (webhooks now; export jobs next).
# Disabled by default to preserve strictly inline behavior.
# ASYNC_JOB_RUNNER_ENABLED=false
# Worker count for async queue (default 2, max 16 when enabled).
# ASYNC_JOB_RUNNER_CONCURRENCY=2
# Max buffered async jobs before non-critical jobs are dropped (with metrics/log).
# ASYNC_JOB_QUEUE_MAX=5000
# Poll retention auto-delete worker (runs in API process):
# - `POLL_RETENTION_TTL_DAYS_DEFAULT`: global default TTL (days) after poll expiration before deletion.
#   Set 0 to disable global auto-delete (per-poll `retention_ttl_days` can still be set but will not sweep when default is 0).
# - `POLL_RETENTION_SWEEP_INTERVAL_SEC`: sweep cadence.
# - `POLL_RETENTION_SWEEP_BATCH_SIZE`: max polls deleted per sweep.
# - `AUDIT_LOG_RETENTION_DAYS`: optional global retention for `audit_logs` rows (0 disables).
# - `MODERATION_REJECTED_VOTE_RETENTION_DAYS`: optional retention for rejected quarantined vote rows (0 disables).
# POLL_RETENTION_TTL_DAYS_DEFAULT=0
# POLL_RETENTION_SWEEP_INTERVAL_SEC=300
# POLL_RETENTION_SWEEP_BATCH_SIZE=200
# AUDIT_LOG_RETENTION_DAYS=0
# MODERATION_REJECTED_VOTE_RETENTION_DAYS=0
# Read-model rollups for heavy analytics reads (admin status first rollout).
# Falls back to canonical votes queries when disabled or unavailable.
# READ_MODEL_ENABLED=false
# Alert threshold on reconcile mismatch count (0 disables count-based alerting).
# READ_MODEL_RECONCILE_ALERT_MISMATCH_COUNT=0
# Alert threshold on reconcile absolute vote diff (0 disables diff-based alerting).
# READ_MODEL_RECONCILE_ALERT_DIFF_THRESHOLD=0
#
# Suggested reconcile threshold profiles:
# - dev: disable alerts while validating shape/parity
#   READ_MODEL_RECONCILE_ALERT_MISMATCH_COUNT=0
#   READ_MODEL_RECONCILE_ALERT_DIFF_THRESHOLD=0
# - staging: low-noise early warning
#   READ_MODEL_RECONCILE_ALERT_MISMATCH_COUNT=3
#   READ_MODEL_RECONCILE_ALERT_DIFF_THRESHOLD=10
# - production: tighter drift detection (tune from baseline)
#   READ_MODEL_RECONCILE_ALERT_MISMATCH_COUNT=1
#   READ_MODEL_RECONCILE_ALERT_DIFF_THRESHOLD=5
# =========================
# Optional LLM gateway
# =========================

# Optional LLM gateway (OpenAI-style paths under /llm). Set provider and base URLs as needed.
# Docker: 127.0.0.1 inside the API container is the container itself — point OLLAMA_BASE_URL /
# LMSTUDIO_BASE_URL at a host the API can reach (e.g. host.docker.internal, LAN IP, tailnet IP,
# or a sidecar service name). Wrong URLs often yield empty models, JSON errors, or upstream 502s.
# If Ollama runs in stacks/ollama (hostname `ollama` on the `monitor` network), asking-ng-api
# must be on that network too — see docker-compose.yml `asking-api` → `monitor`.
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_API_KEY=   # only if Ollama requires auth; sent upstream as Authorization: Bearer <key>
# LLM_PROVIDER=lmstudio
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234
# LMSTUDIO_API_KEY=   # only if LM Studio is configured to require a key
# LLM_GATEWAY_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
#   Required in production when LLM_PROVIDER is enabled (API exits if missing/default).
#   Generate: openssl rand -hex 32
# LLM_ALLOWED_MODELS=llama3.1:8b-instruct,qwen2.5:7b-instruct
#   Optional comma-separated allowlist. When set, /llm/v1/chat/completions rejects other model IDs.
# LLM_ALLOWED_UPSTREAM_HOSTS=ollama,127.0.0.1,localhost
#   Optional in dev, required in production when LLM_PROVIDER is enabled.
#   Only these hostnames are allowed for configured LLM base URLs and upstream fetches.
# LLM_UPSTREAM_TIMEOUT_MS=20000
#   Optional upstream timeout guard for /llm requests (default 20000, max 120000).
# LLM_RATE_LIMIT_WINDOW_MS=60000
# LLM_RATE_LIMIT_MAX_PER_WINDOW=60
#   LLM rate limiting per caller key (Bearer token when present, else remote IP).

# INCIDENT_MODE=true — disables all `/llm/*` routes with **503** `LLM_DISABLED` (no upstream calls).

# =========================
# Optional platform webhooks
# =========================

# Disabled by default. When enabled, API exposes:
#   GET  /platform/webhooks/info
#   POST /platform/webhooks/{twitch|youtube|kick|discord|telegram|slack|x|tiktok|facebook|instagram}
# Platform webhooks are best used behind reverse-proxy path controls + provider IP validation.
# ENABLE_PLATFORM_WEBHOOKS=true
# Shared secret expected in `x-platform-webhook-token` header (required when enabled).
# PLATFORM_WEBHOOK_SHARED_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
# Optional salt used to hash platform subject identifiers before audit storage.
# PLATFORM_WEBHOOK_ID_HASH_SALT=REPLACE_WITH_OPENSSL_RAND_HEX_32
# Recommended minimal OAuth scopes / bot permissions (configure per provider):
# - Twitch EventSub: channel:read:subscriptions (or narrower event-specific read scopes)
# - YouTube PubSub: youtube.readonly
# - Kick: minimal read webhook/event scope supported by your app registration
# - Discord: only bot/webhook permissions required for subscribed events
# - Telegram: webhook bot token permissions scoped to the bot use-case
# - Slack and others: least-privilege event/webhook scopes only
# Minimal stored PII policy: provider, event_type, delivery_id, hashed subject id, received_at only.

# =========================
# Optional Polar billing webhooks (hosted)
# =========================

# Disabled by default. When enabled, API exposes:
#   GET  /billing/webhooks/info
#   POST /billing/webhooks/polar   (raw JSON body; Standard Webhooks via @polar-sh/sdk)
# Behind Caddy with `handle_path /api/*`, public URLs are `/api/billing/...`.
# Docs: stacks/asking-ng/docs/POLAR-BILLING.md
# ENABLE_POLAR_WEBHOOKS=true
# Secret from Polar dashboard for the webhook endpoint (required when enabled).
# POLAR_WEBHOOK_SECRET=REPLACE_WITH_POLAR_WEBHOOK_SECRET
# Optional HTTPS links returned on GET /profile/billing (JWT) for the SPA / upgrade UX (Polar checkout + customer portal).
# POLAR_CUSTOMER_PORTAL_URL=https://polar.sh/portal/...
# POLAR_CHECKOUT_CLOUD_TEAM_URL=https://polar.sh/checkout/...
# POLAR_CHECKOUT_CLOUD_PRO_URL=https://polar.sh/checkout/...
# Map Polar product_id from subscription webhooks to internal billing_plan (optional until you wire products):
# POLAR_PRODUCT_ID_CLOUD_TEAM=...
# POLAR_PRODUCT_ID_CLOUD_PRO=...
# Organization Access Token for **server-side** Polar API (subscription reads). Used by
#   POST /admin/billing/reconcile-polar  (admin JWT or X-Admin-Token) to repair drift vs webhooks.
# POLAR_ACCESS_TOKEN=...
# Polar API host: leave unset or `production` (default); use `sandbox` for Polar sandbox tenants.
# POLAR_SERVER=production
# Optional scheduled background reconcile worker (API process) to repair webhook drift automatically.
# 0 disables the worker; set e.g. 900 for every 15 minutes. Requires POLAR_ACCESS_TOKEN.
# POLAR_RECONCILE_INTERVAL_SEC=0
# Max workspaces scanned per scheduled run (hard-capped in code).
# POLAR_RECONCILE_LIMIT=50
# When true, enforce monetization caps from users.billing_plan (active polls, votes/month, WS room size, data exports/day),
# per-user authenticated REST burst/min (429 `USAGE_LIMIT_API_RATE`), per-workspace outbound **poll** webhook POST attempts/min
# (`USAGE_LIMIT_POLL_WEBHOOK_DELIVERY`), and per-workspace **campaign (UTM) attribution** bumps/day on **`GET /poll/:id`**
# (`USAGE_LIMIT_CAMPAIGN_ATTRIBUTION`). Default off for OSS/self-host.
# BILLING_ENFORCE_LIMITS=true
# Self-host Pro (phase 1): env-backed license state surfaced via GET /profile/billing as
# `billing.selfhostProLicense` (`active` / `grace` / `expired` / `unknown`).
# `SELFHOST_PRO_LICENSE_VALID_UNTIL_MS`: UTC epoch ms when current license validity ends (0 disables evaluation).
# `SELFHOST_PRO_LICENSE_LAST_VERIFIED_MS`: UTC epoch ms when license was last verified (local or remote).
# `SELFHOST_PRO_LICENSE_OFFLINE_GRACE_HOURS`: grace window after expiry while verification is unavailable (default 72h).
# SELFHOST_PRO_LICENSE_VALID_UNTIL_MS=0
# SELFHOST_PRO_LICENSE_LAST_VERIFIED_MS=0
# SELFHOST_PRO_LICENSE_OFFLINE_GRACE_HOURS=72

# Default **pause_message** when `PUT /poll/:id` is called with `{ "panic": true }` and no **pause_message** in the JSON body (max 280 chars).
# PANIC_PAUSE_MESSAGE=Voting is temporarily paused.

# =========================
# Optional trust / anti-raid (API)
# =========================
# When **TRUST_IP_BURST_VOTE_THRESHOLD** is > 0, votes from the same per-poll hashed source IP that
# already have at least that many rows in the rolling **TRUST_IP_BURST_WINDOW_SEC** window are
# accepted but **auto-quarantined** (`ip_burst`, with a mod-visible **trust_risk_score**). Default 0 = off.
# Poll owners also see **`moderation_counters.trust_ip_burst`** and **`integrity_panel.safeguards_applied`**
# includes **`trust_stack:ip_burst`** on **GET /poll/:id** and compact **GET /poll/:id/meta** when enabled.
# TRUST_IP_BURST_WINDOW_SEC=10
# TRUST_IP_BURST_VOTE_THRESHOLD=0
#
# **TRUST_CHAT_BURST_VOTE_THRESHOLD** (default 0 = off): same idea for **`chat_channel_id`** on votes —
# when set, votes with the same channel id in **TRUST_CHAT_BURST_WINDOW_SEC** are auto-quarantined (`chat_burst`).
# Owner **`moderation_counters.trust_chat_burst`** and **`trust_stack:chat_burst`** in **`integrity_panel`** when enabled.
# TRUST_CHAT_BURST_WINDOW_SEC=10
# TRUST_CHAT_BURST_VOTE_THRESHOLD=0

# =========================
# Optional runtime metadata
# =========================

# Logging (pino): trace | debug | info | warn | error
# LOG_LEVEL=info

# Optional: restrict browser CORS to specific origins (comma-separated). If unset, all origins are allowed (typical behind Caddy).
# CORS_ORIGIN=https://asking-ng.example.com

# Public site URL (no trailing slash) for oEmbed / embed discovery (GET /poll/:id/embed). Falls back to CORS_ORIGIN or the request Host when unset.
# PUBLIC_SITE_URL=https://asking-ng.example.com

# Optional auth-proxy login bridge for self-hosted OIDC forward-auth setups (Authentik/Keycloak/Zitadel via reverse proxy):
# POST /auth/proxy-login reads trusted headers and mints a local JWT.
# Keep this OFF unless your edge proxy strips/spoofs-protects these headers.
# AUTH_PROXY_ENABLED=true
# AUTH_PROXY_PROVIDER=authentik
# Supported presets: generic, authentik, authelia, oauth2-proxy, traefik-forward-auth, keycloak
# AUTH_PROXY_USER_HEADER=x-auth-request-user
# AUTH_PROXY_EMAIL_HEADER=x-auth-request-email
# AUTH_PROXY_GROUPS_HEADER=x-auth-request-groups
# AUTH_PROXY_ROLE_HEADER=x-auth-request-role
# AUTH_PROXY_ALLOWED_ROLES=user,admin,superadmin
# AUTH_PROXY_DEFAULT_ROLE=user
# AUTH_PROXY_AUTO_PROVISION=true
# Optional: only allow /auth/proxy-login from these source IPs/CIDRs (comma-separated).
# AUTH_PROXY_TRUSTED_IPS=127.0.0.1,172.18.0.0/16

# WebSocket live polls (`/ws/poll/:id`): optional hardening (see api `pollLive.ts` / `pollWsGuards.ts`).
# If `WS_ALLOWED_ORIGINS` is non-empty (comma-separated), it is the only Origin allowlist for WS; otherwise `CORS_ORIGIN` is used when non-empty.
# When an allowlist is non-empty, requests without `Origin` are rejected unless WS_ALLOW_MISSING_ORIGIN=true (e.g. some probes).
# WS_ALLOWED_ORIGINS=https://asking-ng.example.com
# WS_ALLOW_MISSING_ORIGIN=false
# WS_UPGRADE_MAX_PER_IP=45
# WS_UPGRADE_WINDOW_MS=60000
# Hard ceiling for concurrent WS clients per poll; with BILLING_ENFORCE_LIMITS, effective cap is min(this value, tier from MONETIZATION-AND-PACKAGING.md).
# WS_MAX_SUBSCRIBERS_PER_POLL=250
# Server→client poll-live JSON messages per poll per second (notifyPollLive); with BILLING_ENFORCE_LIMITS, effective cap is min(this value, tier fanout row).
# WS_FANOUT_MAX_PER_POLL_PER_SEC=10000

# Optional: override name in GET /info JSON (defaults to asking-ng-api)
# SERVICE_NAME=asking-ng-api

# Optional: shown in GET /info when set (e.g. CI injects commit SHA)
# GIT_COMMIT=
#
# Dev/script-only env knobs (SLO smoke, reconcile smoke, perf baseline, contract snapshots,
# monitoring smoke tunables) live in `stack.env.dev.example` to keep deploy config concise.
