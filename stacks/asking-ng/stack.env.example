# asking-ng — copy to stack.env and set real values. Do NOT commit real secrets.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# =========================
# Optional debug host port
# =========================
# Default compose keeps the API internal-only (no host binding).
# For local smoke checks use the debug override compose file:
#   docker compose -f docker-compose.yml -f docker-compose.debug.yml up -d --build
# ASKING_NG_API_HOST_PORT=18081

# =========================
# Required for first start
# =========================

# PostgreSQL credentials
POSTGRES_DB=asking
POSTGRES_USER=asking
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=changeme

# =========================
# Build-time frontend config
# =========================

# Public browser origin (no trailing slash), baked into the client image at build time.
# VITE_PUBLIC_ORIGIN=https://asking-ng.example.com

# Public origin for docs canonical URLs / sitemap / Open Graph (no trailing slash).
DOCS_SITE_URL="https://asking-ng.example.com"

# Optional: URL for "Edit this page" links pointing to your source repo.
# PUBLIC_DOCS_EDIT_BASE_URL=https://gitea.example.com/org/repo/src/branch/main/docs/content

# Optional: use git log for "Updated …" timestamps on docs pages (requires .git in build context).
DOCS_LAST_UPDATED_FROM_GIT=1

# =========================
# Secrets
# =========================

# JWT secret for user sessions. Required in production (API exits if missing).
# Generate with: openssl rand -hex 64
JWT_SECRET=changeme

# Hash salts — generate unique random values for your install.
# Generate each with: openssl rand -hex 32
VOTE_IP_HASH_SALT=changeme
PLATFORM_WEBHOOK_ID_HASH_SALT=changeme

# Admin UI token (sent as x-admin-token on admin API requests).
# Generate with: openssl rand -base64 48 | tr -d '\n'
ADMIN_TOKEN=changeme

# =========================
# Optional LLM gateway
# =========================

# Set LLM_PROVIDER to enable the /llm gateway. Supported: ollama, lmstudio.
# If Ollama runs in stacks/ollama, ensure asking-ng-api is on the monitor network.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL="http://ollama:11434"
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234

# =========================
# Optional runtime metadata
# =========================

# CORS origin(s) — restrict browser access (comma-separated, or leave broad behind Caddy)
CORS_ORIGIN="https://asking-ng.example.com"

# Public site URL for oEmbed / embed discovery
PUBLIC_SITE_URL="https://asking-ng.example.com"

# Expose version/node/commit details in GET /info (disable for hardened production)
EXPOSE_SERVICE_INFO_DETAILS=true

# Swagger UI at /api-docs
ENABLE_API_DOCS=true
