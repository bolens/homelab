# asking-ng — copy to stack.env and set strong secrets.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Postgres
POSTGRES_DB=asking
POSTGRES_USER=asking
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD

# Browser + axios call the API under this path (must match Caddy handle_path /api)
VITE_API_BASE=/api

# Admin UI (/admin/*) — set a strong token; required for admin routes
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# Frontend container
FRONTEND_DOCKERFILE=Dockerfile.dev
FRONTEND_EXPOSE_PORT=3000
