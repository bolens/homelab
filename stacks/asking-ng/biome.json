{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "packages/contracts/src/**",
      "client/src/**",
      "client/e2e/**",
      "api/src/**",
      "client/vite.config.ts",
      "client/playwright.config.ts",
      "client/index.html",
      "api/vitest.config.ts",
      "client/package.json",
      "api/package.json",
      "client/tsconfig.json",
      "api/tsconfig.json",
      "client/knip.json",
      "api/knip.json",
      "packages/contracts/package.json",
      "packages/contracts/tsconfig.json",
      "packages/contracts/vitest.config.ts",
      "client/.oxlintrc.json",
      "api/.oxlintrc.json",
      "biome.json",
      "turbo.json",
      "package.json",
      "client/start-all.sh"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
