# Logseq sync — split-horizon + public TLS: logseq.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

logseq.home, logseq.local {
	tls internal
	reverse_proxy logseq-sync:80 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://logseq.example.com {
	reverse_proxy logseq-sync:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

logseq.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy logseq-sync:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
