# Whisper ASR webservice — https://github.com/ahmetoner/whisper-asr-webservice
# Copy to stack.env (or run ./prepare-stack.sh). Do NOT commit stack.env.
#
# ASR_ENGINE: openai_whisper | faster_whisper | whisperx
# ASR_MODEL: tiny, base, small, medium, large-v3, ...
ASR_ENGINE=faster_whisper
ASR_MODEL=base
ASR_DEVICE=cpu

# Optional: unload model after idle (seconds)
# MODEL_IDLE_TIMEOUT=300

# TZ/locale: use ../../shared.env (see documents/SHARED-RESOURCES.md)
