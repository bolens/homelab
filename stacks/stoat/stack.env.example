# Stoat (self-hosted Revolt) — chat server with API, web, media, and voice.
# Copy to stack.env and customize. Do NOT commit real credentials.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
#
# Docs: https://docs.stoat.dev/docs/installation
# Before first run: run generate_config.sh in this directory (see README).

# ---------------------------------------------------------------------------
# RabbitMQ — internal message broker
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 16
RABBITMQ_DEFAULT_USER=rabbituser
RABBITMQ_DEFAULT_PASS=changeme

# ---------------------------------------------------------------------------
# MinIO — S3-compatible storage for attachments, avatars, etc.
# Revolt.toml (Autumn) must use the same credentials.
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 16
MINIO_ROOT_USER=minioautumn
MINIO_ROOT_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Config path — host path to Revolt.toml
# ---------------------------------------------------------------------------
STOAT_CONFIG_PATH=/home/youruser/.config/stoat/Revolt.toml

# ---------------------------------------------------------------------------
# Web / Caddy — required for Portainer/Git deploy (replaces .env.web)
# Replace stoat.example.com with your real public hostname.
# ---------------------------------------------------------------------------
STOAT_DOMAIN=stoat.example.com
HOSTNAME=:80
REVOLT_PUBLIC_URL=https://stoat.example.com/api
VITE_API_URL=https://stoat.example.com/api
VITE_WS_URL=wss://stoat.example.com/ws
VITE_MEDIA_URL=https://stoat.example.com/autumn
VITE_PROXY_URL=https://stoat.example.com/january
VITE_CFG_ENABLE_VIDEO=true
