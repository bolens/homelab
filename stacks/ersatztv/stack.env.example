# Copy to stack.env. Re-run preparation after changes to update .env.
# TZ and locale come from optional ../../shared.env.
# Required existing media directory; verify its filesystem before deployment.
# Mounted read-only at /media; neither preparation nor Compose creates it.
ERSATZTV_MEDIA_PATH=/path/to/media

# Optional NVIDIA override only: GPU index or UUID reported by nvidia-smi.
# ERSATZTV_GPU_ID=0

# Optional host maintenance is configured outside container environment files.
# See ../dispatcharr/maintenance/ and this stack's README for recipe/backup setup.
