# syntax=docker/dockerfile:1

ARG BASE_IMAGE=ail-framework:7.0-cpu-build
FROM ${BASE_IMAGE}

# Redis 5 bundled by AIL does not implement RESP3's HELLO command.
# redis-py 8 defaults to RESP3, so retain the compatible RESP2-era client.
COPY requirements-runtime.txt /tmp/requirements-runtime.txt
COPY ail-dark-mode.css /tmp/ail-dark-mode.css
COPY ail-dark-mode.js /tmp/ail-dark-mode.js
RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/AIL/AILENV/bin/pip install --require-hashes \
        -r /tmp/requirements-runtime.txt \
    && cat /tmp/ail-dark-mode.css >> /opt/AIL/var/www/static/css/bootstrap4.min.css \
    && cat /tmp/ail-dark-mode.js >> /opt/AIL/var/www/static/js/echarts.min.js \
    && rm /tmp/requirements-runtime.txt /tmp/ail-dark-mode.css /tmp/ail-dark-mode.js \
    && sed -i 's/^host = 127[.]0[.]0[.]1$/host = 0.0.0.0/' \
        /opt/AIL/configs/core.cfg \
        /opt/AIL/configs/core.cfg.sample \
    # Release images are immutable; keep Git metadata read-only for /settings,
    # but disable AIL's launch-time self-update.
    && sed -i '/^    update;$/d' /opt/AIL/bin/LAUNCH.sh
