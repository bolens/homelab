ARG BASE_IMAGE=ail-framework:6.7-cpu-build
FROM ${BASE_IMAGE}

# Redis 5 bundled by AIL does not implement RESP3's HELLO command.
# redis-py 8 defaults to RESP3, so retain the compatible RESP2-era client.
RUN /opt/AIL/AILENV/bin/pip install --no-cache-dir \
    "redis==5.3.1" \
    "lexilang==1.0.7" \
    && sed -i 's/^host = 127[.]0[.]0[.]1$/host = 0.0.0.0/' \
        /opt/AIL/configs/core.cfg \
        /opt/AIL/configs/core.cfg.sample
