ARG GPU_IMAGE=ail-framework:6.7-gpu
FROM ${GPU_IMAGE} AS cpu_builder

# EasyOCR installs CUDA-enabled PyTorch by default. Replace it and all bundled
# NVIDIA runtime wheels with the official CPU builds.
RUN /opt/AIL/AILENV/bin/pip freeze \
        | sed -nE '/^(torch|torchvision|triton|cuda-|nvidia-)/Ip' \
        | grep -vi '^nvidia-ml-py==' \
        | cut -d= -f1 \
        | xargs -r /opt/AIL/AILENV/bin/pip uninstall -y \
    && /opt/AIL/AILENV/bin/pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        "torch==2.13.0" "torchvision==0.28.0" \
    && rm -rf /root/.cache /tmp/* /var/tmp/*

# Repack from scratch so the removed CUDA files do not survive in a lower layer.
FROM scratch
COPY --from=cpu_builder / /

ENV LANG=C.UTF-8 \
    AIL_HOME=/opt/AIL \
    AIL_BIN=/opt/AIL/bin \
    AIL_FLASK=/opt/AIL/var/www \
    AIL_REDIS=/opt/AIL/redis/src \
    AIL_ARDB=/opt/AIL/ardb/src \
    AIL_VENV=/opt/AIL/AILENV \
    PATH=/opt/AIL/AILENV/bin:/opt/AIL:/opt/AIL/redis/src:/opt/AIL/ardb/src:/opt/AIL/bin:/opt/AIL/var/www:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /opt/AIL
ENTRYPOINT ["/bin/bash", "/opt/AIL/docker_start.sh"]
