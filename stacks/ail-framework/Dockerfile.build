# syntax=docker/dockerfile:1

FROM ubuntu:22.04@sha256:3b06811b2afd352be909dd088a004166d665dc76d38b13eada33522a9d915c6f AS native_builder

ARG tz_buildtime=Europe/Rome
ENV TZ=$tz_buildtime

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo "$TZ" > /etc/timezone

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update -y \
    && apt-get upgrade -y \
    && apt-get dist-upgrade -y \
    && apt-get install -y --no-install-recommends \
        git python3-dev build-essential libffi-dev libssl-dev libfuzzy-dev \
        wget sudo python3-requests python3-yaml python3-redis \
    && apt-get autoremove -y

RUN useradd -m docker \
    && echo "docker:docker" | chpasswd \
    && adduser docker sudo \
    && echo "root ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

COPY ail-framework-docker/ail-framework /opt/AIL
WORKDIR /opt/AIL

# Keep network inputs shallow and deterministic. YARA's tests belong in CI;
# omitting make check does not alter the installed runtime.
RUN sed -i \
    -e 's|git submodule update --init --recursive|git submodule update --init --recursive --depth 1|' \
    -e 's|git clone https://github.com/redis/redis.git|git clone --depth 1 --branch 5.0 https://github.com/redis/redis.git|' \
    -e 's|git clone https://github.com/trendmicro/tlsh.git|git clone --depth 1 https://github.com/trendmicro/tlsh.git|' \
    -e 's|git clone https://github.com/kazu-yamamoto/pgpdump.git|git clone --depth 1 https://github.com/kazu-yamamoto/pgpdump.git|' \
    -e 's|git clone https://github.com/apache/incubator-kvrocks.git kvrocks|git clone --depth 1 https://github.com/apache/incubator-kvrocks.git kvrocks|' \
    -e 's|git fetch --depth=500 --tags --prune|git fetch --depth=1 --tags --prune|' \
    -e 's/ python3-numpy//' \
    -e '/python3-opencv/d' \
    -e '/^make check$/d' \
    installing_deps.sh

RUN sed -i \
    -e 's|git clone https://github.com/cvandeplas/pystemon.git /opt/pystemon|git init /opt/pystemon \&\& git -C /opt/pystemon remote add origin https://github.com/cvandeplas/pystemon.git \&\& git -C /opt/pystemon fetch --depth 1 origin 7e3665674f60250c198b23ad4b87d4393e8e65bb \&\& git -C /opt/pystemon checkout --detach FETCH_HEAD \&\& test "$(git -C /opt/pystemon rev-parse HEAD)" = 7e3665674f60250c198b23ad4b87d4393e8e65bb|' \
    -e '/apt-get update/d' \
    -e '/apt-get install/d' \
    -e '/pip3 install beautifulsoup4/d' \
    other_installers/docker/pystemon/install.sh

# This expensive native layer is invariant across CPU and GPU variants.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    AIL_INSTALL_PHASE=native ./installing_deps.sh

FROM native_builder AS variant_builder

ARG AIL_TORCH_VARIANT=cpu
COPY requirements-cpu.txt /tmp/requirements-cpu.txt

# Python dependencies vary by Torch flavor while reusing the native layer.
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    AIL_INSTALL_PHASE=python \
    AIL_TORCH_VARIANT=${AIL_TORCH_VARIANT} \
    ./installing_deps.sh

COPY requirements-pystemon.txt /tmp/requirements-pystemon.txt
COPY requirements-opencv.txt /tmp/requirements-opencv.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    ./other_installers/docker/pystemon/install.sh \
    && pip3 install --require-hashes -r /tmp/requirements-pystemon.txt \
    && rm /tmp/requirements-pystemon.txt \
    # qreader pulls both GUI and headless OpenCV wheels. Keep one cv2 runtime.
    && /opt/AIL/AILENV/bin/pip uninstall -y opencv-python coverage nose2 \
    && /opt/AIL/AILENV/bin/pip install --force-reinstall --no-deps \
        --require-hashes -r /tmp/requirements-opencv.txt \
    && rm /tmp/requirements-opencv.txt

COPY ail-framework-docker/ail-framework/other_installers/docker/docker_start.sh /opt/AIL/docker_start.sh

# Preserve application runtime packages before autoremove, then discard
# compilers, headers, package tests, sources, docs, and transient caches.
    RUN apt-mark manual \
        file graphviz libadns1 libev4 libfuzzy2 libgmp10 libmagic-mgc \
        libmagic1 libprotobuf23 libsnappy1v5 libssl3 libzbar0 p7zip-full \
        git screen sudo wget \
    && strip --strip-unneeded /opt/AIL/kvrocks/build/kvrocks \
    && find /opt/AIL/kvrocks/build -mindepth 1 -maxdepth 1 \
        ! -name kvrocks -exec rm -rf {} + \
    # AIL 7.0's settings page reads release metadata from the root checkout.
    # Keep that checkout while removing nested dependency repositories.
    && find /opt/AIL -mindepth 2 -type d -name .git -prune -exec rm -rf {} + \
    && find /opt/AIL -type d -name __pycache__ -prune -exec rm -rf {} + \
    && find /opt/AIL -type f -name '*.pyc' -delete \
    && find /opt/AIL/AILENV/lib/python3.10/site-packages -type d \
        \( -name test -o -name tests \) -prune -exec rm -rf {} + \
    # Upstream downloads corpora below the TLSH source tree; preserve them
    # before deleting that build-only checkout.
    && mkdir -p /opt/AIL/nltk_data \
    && cp -a /opt/AIL/tlsh/py_ext/nltk_data/. /opt/AIL/nltk_data/ \
    && cp -a /root/nltk_data/. /opt/AIL/nltk_data/ \
    && rm -rf \
        /opt/AIL/tests /opt/AIL/tlsh /opt/AIL/pgpdump /opt/AIL/doc \
        /opt/AIL/redis/deps /opt/AIL/redis/tests \
        /usr/share/doc/* \
    && mkdir -p /opt/AIL/doc \
    && find /opt/AIL/redis/src -type f ! -perm /111 -delete \
    && strip --strip-unneeded \
        /opt/AIL/redis/src/redis-server \
        /opt/AIL/redis/src/redis-cli \
        /opt/AIL/redis/src/redis-benchmark \
    && apt-get purge -y \
        autoconf automake binutils binutils-x86-64-linux-gnu \
        build-essential cmake cmake-data cpp cpp-11 g++ g++-11 gcc gcc-11 \
        libadns1-dev libffi-dev libfreetype6-dev libfuzzy-dev \
        libgmp-dev libprotobuf-dev libsnappy-dev libssl-dev libtool \
        linux-libc-dev make pkg-config protobuf-compiler python3-dev \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /root/.cache /tmp/* /var/tmp/* /var/lib/apt/lists/*

FROM scratch
COPY --from=variant_builder / /

ENV LANG=C.UTF-8 \
    NLTK_DATA=/opt/AIL/nltk_data \
    AIL_HOME=/opt/AIL \
    AIL_BIN=/opt/AIL/bin \
    AIL_FLASK=/opt/AIL/var/www \
    AIL_REDIS=/opt/AIL/redis/src \
    AIL_ARDB=/opt/AIL/ardb/src \
    AIL_VENV=/opt/AIL/AILENV \
    PATH=/opt/AIL/AILENV/bin:/opt/AIL:/opt/AIL/redis/src:/opt/AIL/ardb/src:/opt/AIL/bin:/opt/AIL/var/www:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /opt/AIL
ENTRYPOINT ["/bin/bash", "/opt/AIL/docker_start.sh"]
