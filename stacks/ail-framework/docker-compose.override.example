# Use this override when running an AIL 6.x image built from the official repo.
# Official images use AIL_HOME=/opt/AIL (not /opt/ail-framework). Copy to docker-compose.override.yml
# and build the image first (see README "Using AIL 6.x").
#
# cp docker-compose.override.example docker-compose.override.yml
# Then build: see README (v6.7). Then docker compose --env-file stack.env up -d

services:
  ail:
    image: ${AIL_IMAGE:-ail-framework:6.7}
    volumes:
      - ail-pastes:/opt/AIL/PASTES
      - ail-screenshots:/opt/AIL/CRAWLED_SCREENSHOT
      - ail-kvrocks:/opt/AIL/DATA_KVROCKS
      - ail-indexdir:/opt/AIL/indexdir
      - ail-hashs:/opt/AIL/HASHS
      - ail-logs:/opt/AIL/logs
