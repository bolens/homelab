# AIL framework – copy to stack.env if you need to override.
# The default image is cciucd/ail-framework:latest (5.x). See https://github.com/ail-project/ail-framework and doc/README.md for configs.

# Optional: use a different image (e.g. official 7.x build or your Harbor image).
# AIL_IMAGE=harbor.local/homelab/ail-framework:7.0
AIL_IMAGE=ail-framework:7.0
# Public Harbor behind Cloudflare often caps uploads (~100MB); use harbor.local for large images.

# Pinned companion crawler builds.
LACUS_IMAGE=ail-lacus:1.25.1
LACUS_REVISION=e3be12569431234dfc08cffd4a5000cd86011545
VALSTORE_REVISION=23b3f6bb66c19502225a40e7aeec9e1be76456c1

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
