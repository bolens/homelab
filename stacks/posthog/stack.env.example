# PostHog hobby — copy to stack.env, then ./prepare-stack.sh (do not commit secrets).
#
# Upstream: https://posthog.com/docs/self-host/deploy/hobby
# Repo: https://github.com/PostHog/posthog
#
# If POSTHOG_SECRET / ENCRYPTION_SALT_KEYS are still the REPLACE_* placeholders below,
# ./prepare-stack.sh generates new values automatically (same idea as upstream deploy-hobby).

# Public hostname only (no https://). Must match your Caddy / tunnel hostname.
DOMAIN=posthog.example.com

# Django secret (56 hex chars from prepare-stack when placeholder is used).
POSTHOG_SECRET=REPLACE_POSTHOG_SECRET

# 32 hex chars (16 bytes) for encrypted fields; auto-generated when placeholder is used.
ENCRYPTION_SALT_KEYS=REPLACE_ENCRYPTION_SALT_KEYS

# Image tag (default latest). See https://hub.docker.com/r/posthog/posthog/tags
POSTHOG_APP_TAG=latest

# Optional: Node image tag for plugins/ingestion (default latest in compose).
# POSTHOG_NODE_TAG=latest

# Container registry path for main app image (default upstream).
REGISTRY_URL=posthog/posthog

# Leave empty when TLS is terminated at homelab Caddy (see docker-compose.homelab.yml).
TLS_BLOCK=

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md) — optional ../../shared.env when compose runs from this repo.
