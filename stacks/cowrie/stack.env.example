# Cowrie – SSH/Telnet honeypot.
# Copy to stack.env and adjust as needed before running prepare-stack.sh.
#
# TZ/locale: provided by ../../shared.env (see documents/SHARED-RESOURCES.md)
# PUID/PGID: add when a docker-compose.yml is created if the image respects them

# Optional: Splunk HEC host for log shipping
# COWRIE_OUTPUT_SPLUNK_HOST=changeme
# Optional: Splunk HEC token  # generate: openssl rand -hex 16
# COWRIE_OUTPUT_SPLUNK_TOKEN=changeme
