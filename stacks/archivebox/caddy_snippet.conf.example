# ArchiveBox — split-horizon + public TLS: archivebox.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

archivebox.home, archivebox.local {
	tls internal
	reverse_proxy archivebox:8000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://archivebox.example.com {
	reverse_proxy archivebox:8000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

archivebox.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy archivebox:8000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
