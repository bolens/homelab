# ArchiSteamFarm – optional environment variables
#
# Copy to stack.env and adjust. ASF is configured mainly via files in the config volume
# (ASF.json, bot configs). See README for IPC (web UI) and Kestrel setup.

# Config directory for ASF.json and bot configs (used by prepare-stack.sh and compose volume).
# Example: ./config (relative to stack dir). Use an absolute path or ~/.config/asf for a fixed location.
# ASF_CONFIG_DIR=./config

# Optional: run ASF as this UID (e.g. match host user for volume file ownership)
# ASF_UID=1000

# IPC (web UI) is bound to 0.0.0.0:1242 via ASPNETCORE_URLS in docker-compose so Caddy can reach it.

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
