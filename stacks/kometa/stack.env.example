# Kometa — Plex metadata manager (formerly Plex Meta Manager).
# Copy to stack.env and adjust as needed.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# File ownership — match your host user (run: id -u && id -g)
PUID=1000
PGID=1000

# Host paths for Kometa config and data (absolute paths required for Portainer deploys)
KOMETA_HOST_CONFIG_PATH=/path/to/kometa/config
KOMETA_HOST_DATA_PATH=/path/to/kometa/data
