# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000

# Optional: instance tuning
# READARR__InstanceName=Readarr
# READARR__BindAddress=*
# READARR__Port=8787


# Unified media tree (host → /data). Libraries and downloads must share this
# mount so imports can use atomic moves/hardlinks instead of copying.
READARR_MEDIA_PATH=/path/to/media

# Self-hosted Hardcover metadata. Generate the PostgreSQL password with:
# openssl rand -hex 32
HARDCOVER_AUTH=Bearer replace-with-hardcover-api-token
RREADING_GLASSES_POSTGRES_PASSWORD=replace-with-random-password
