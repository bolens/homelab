# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000

# Optional: instance tuning
# READARR__InstanceName=Readarr
# READARR__BindAddress=*
# READARR__Port=8787


# Media library bind mount (host → /books in container)
READARR_BOOKS_PATH=/mnt/unraid/media/books

# Usenet downloads bind mount (host → /downloads; shared with NZBGet)
READARR_USENET_DOWNLOADS_PATH=/mnt/unraid/media/downloads/usenet
