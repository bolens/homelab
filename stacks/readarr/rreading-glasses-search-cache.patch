+package internal
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/Khan/genqlient/graphql"
+	"github.com/blampe/rreading-glasses/hardcover"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/mock/gomock"
+)
+
+func TestHardcoverSearchCache(t *testing.T) {
+	for _, mode := range []string{"complete", "partial", "empty", "error", "expired", "corrupt", "cancelled", "invalidated", "existing-edition"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx := context.Background()
+			if mode == "cancelled" {
+				cancelled, cancel := context.WithCancel(ctx)
+				cancel()
+				ctx = cancelled
+			}
+			cache := newMemoryCache()
+			gql := hardcover.NewMockgql(gomock.NewController(t))
+			calls := 1
+			if mode == "partial" || mode == "empty" || mode == "error" || mode == "cancelled" || mode == "invalidated" {
+				calls = 2
+			}
+			gql.EXPECT().MakeRequest(gomock.Any(), gomock.Any(), gomock.Any()).DoAndReturn(
+				func(_ context.Context, req *graphql.Request, resp *graphql.Response) error {
+					require.Equal(t, "Search", req.OpName)
+					if mode == "error" {
+						return fmt.Errorf("upstream unavailable")
+					}
+					ids := []int64{101}
+					if mode == "partial" {
+						ids = append(ids, 102)
+					}
+					if mode == "empty" {
+						ids = nil
+					}
+					resp.Data.(*hardcover.SearchResponse).Search.Ids = ids
+					return nil
+				}).Times(calls)
+			work, err := json.Marshal(workResource{ForeignID: 101, BestBookID: 201, Authors: []AuthorResource{{ForeignID: 301}}, Books: []bookResource{{ForeignID: 201}}})
+			require.NoError(t, err)
+			cache.Set(ctx, WorkKey(101), work, time.Hour)
+			if mode == "existing-edition" {
+				cache.Set(ctx, BookKey(201), work, time.Hour)
+			}
+			if mode == "partial" {
+				cache.Set(ctx, WorkKey(102), []byte("invalid"), time.Hour)
+			}
+			key := "/search?q=test+book"
+			if mode == "expired" {
+				cache.Set(ctx, key, []byte(`[{"workid":999}]`), time.Nanosecond)
+				time.Sleep(time.Millisecond)
+			}
+			if mode == "corrupt" {
+				cache.Set(ctx, key, []byte("invalid"), time.Hour)
+			}
+			getter, err := NewHardcoverGetter(cache, gql)
+			require.NoError(t, err)
+			for attempt := range 2 {
+				if mode == "invalidated" && attempt == 1 {
+					require.NoError(t, cache.Expire(ctx, key))
+				}
+				results, err := getter.Search(ctx, "test book")
+				if mode == "error" {
+					require.Error(t, err)
+					continue
+				}
+				require.NoError(t, err)
+				if mode == "empty" {
+					require.Empty(t, results)
+				} else {
+					require.Len(t, results, 1)
+					require.Equal(t, int64(101), results[0].WorkID)
+					cached, _, ok := cache.GetWithTTL(ctx, BookKey(201))
+					require.True(t, ok)
+					require.JSONEq(t, string(work), string(cached))
+					_, workTTL, _ := cache.GetWithTTL(ctx, WorkKey(101))
+					require.LessOrEqual(t, workTTL, time.Hour)
+					if mode == "existing-edition" {
+						_, editionTTL, _ := cache.GetWithTTL(ctx, BookKey(201))
+						require.LessOrEqual(t, editionTTL, time.Hour)
+					}
+				}
+			}
+			_, ttl, ok := cache.GetWithTTL(ctx, key)
+			if mode == "partial" || mode == "empty" || mode == "error" || mode == "cancelled" {
+				require.False(t, ok)
+			} else {
+				require.True(t, ok)
+				require.LessOrEqual(t, ttl, 15*time.Minute)
+			}
+		})
+	}
+}
+
+func TestHardcoverSearchRetainsColdMetadata(t *testing.T) {
+	ctx := context.Background()
+	cache := newMemoryCache()
+	gql := hardcover.NewMockgql(gomock.NewController(t))
+	author := map[string]any{"id": 301, "name": "Example Author"}
+	contributions := []any{map[string]any{"contribution": "Author", "author": author}}
+	work := map[string]any{"id": 101, "title": "Example Book", "contributions": contributions, "default_ebook_edition": map[string]any{"id": 201, "contributions": contributions}}
+	edition := map[string]any{"id": 201, "title": "Example Book", "book": work}
+	{
+		gql.EXPECT().MakeRequest(gomock.Any(), gomock.Any(), gomock.Any()).DoAndReturn(
+			func(_ context.Context, req *graphql.Request, resp *graphql.Response) error {
+				var data any
+				switch req.OpName {
+				case "Search":
+					data = map[string]any{"search": map[string]any{"ids": []int64{101}}}
+				case "GetWork":
+					data = map[string]any{"books_by_pk": work}
+				case "GetEdition":
+					data = map[string]any{"editions_by_pk": edition}
+				default:
+					return fmt.Errorf("unexpected operation %s", req.OpName)
+				}
+				raw, err := json.Marshal(data)
+				if err != nil {
+					return err
+				}
+				return json.Unmarshal(raw, resp.Data)
+			}).Times(3)
+	}
+	getter, err := NewHardcoverGetter(cache, gql)
+	require.NoError(t, err)
+	results, err := getter.Search(ctx, "example")
+	require.NoError(t, err)
+	require.Len(t, results, 1)
+	require.Equal(t, int64(201), results[0].BookID)
+	// Result hydration must reuse metadata even without a cached search response.
+	require.NoError(t, cache.Expire(ctx, "/search?q=example"))
+	_, _, err = getter.GetWork(ctx, 101, nil)
+	require.NoError(t, err)
+	_, _, _, err = getter.GetBook(ctx, 201, nil)
+	require.NoError(t, err)
+}
