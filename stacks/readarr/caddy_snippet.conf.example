# Readarr — split-horizon + public TLS: readarr.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

readarr.home, readarr.local {
	tls internal
	reverse_proxy readarr:8787 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://readarr.example.com {
	reverse_proxy readarr:8787 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

readarr.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy readarr:8787 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
