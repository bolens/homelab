# Lidarr — split-horizon + public TLS: lidarr.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

lidarr.home, lidarr.local {
	tls internal
	reverse_proxy lidarr:8686 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://lidarr.example.com {
	reverse_proxy lidarr:8686 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

lidarr.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy lidarr:8686 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
