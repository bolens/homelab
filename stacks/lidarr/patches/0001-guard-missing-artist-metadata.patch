+using System.Collections.Generic;
+using FizzWare.NBuilder;
+using FluentAssertions;
+using NLog;
+using NUnit.Framework;
+using NzbDrone.Core.Datastore;
+using NzbDrone.Core.MediaFiles;
+using NzbDrone.Core.MediaFiles.TrackImport.Specifications;
+using NzbDrone.Core.Music;
+using NzbDrone.Core.Parser.Model;
+using NzbDrone.Core.Profiles.Qualities;
+using NzbDrone.Core.Qualities;
+using NzbDrone.Core.Test.Framework;
+
+namespace NzbDrone.Core.Test.MediaFiles.TrackImport.Specifications
+{
+    [TestFixture]
+    public class AlbumUpgradeSpecificationFixture : CoreTest
+    {
+        [Test]
+        public void should_ignore_orphaned_existing_track_file_relation()
+        {
+            var artist = Builder<Artist>.CreateNew()
+                .With(x => x.QualityProfile = new QualityProfile
+                {
+                    Items = Qualities.QualityFixture.GetDefaultQualities()
+                })
+                .Build();
+
+            var currentRelease = Builder<AlbumRelease>.CreateNew()
+                .With(x => x.Monitored = true)
+                .With(x => x.Tracks = new List<Track>
+                {
+                    new Track
+                    {
+                        TrackFileId = 1,
+                        TrackFile = new LazyLoaded<TrackFile>()
+                    }
+                })
+                .Build();
+
+            var album = Builder<Album>.CreateNew()
+                .With(x => x.Artist = artist)
+                .With(x => x.AlbumReleases = new List<AlbumRelease> { currentRelease })
+                .Build();
+
+            currentRelease.Album = album;
+
+            var newRelease = Builder<AlbumRelease>.CreateNew()
+                .With(x => x.Id = currentRelease.Id + 1)
+                .With(x => x.Album = album)
+                .Build();
+
+            var localRelease = new LocalAlbumRelease(new List<LocalTrack>
+            {
+                new LocalTrack { Quality = new QualityModel(Quality.FLAC) }
+            })
+            {
+                AlbumRelease = newRelease
+            };
+
+            var subject = new AlbumUpgradeSpecification(LogManager.GetLogger("AlbumUpgradeSpecificationFixture"));
+            var decision = subject.IsSatisfiedBy(localRelease, null);
+
+            decision.Accepted.Should().BeTrue();
+        }
+    }
+}
