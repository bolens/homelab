# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000

# Optional: instance tuning
# LIDARR__InstanceName=Lidarr
# LIDARR__BindAddress=*
# LIDARR__Port=8686


# Staging library bind mount (host → /music in container). Keep this separate
# from the library exposed by Navidrome and Soulseek.
LIDARR_INTAKE_PATH=/path/to/media/intake/lidarr

# Usenet downloads bind mount (host → /downloads; shared with NZBGet)
LIDARR_USENET_DOWNLOADS_PATH=/path/to/media/downloads/usenet
