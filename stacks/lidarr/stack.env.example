# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000

# Optional: instance tuning
# LIDARR__InstanceName=Lidarr
# LIDARR__BindAddress=*
# LIDARR__Port=8686


# Unified media tree (host → /data). The library is /data/music and download
# intake is below /data/downloads.
LIDARR_MEDIA_PATH=/path/to/media
# Harbor fallback: LIDARR_IMAGE=harbor.bolens.dev/homelab/lidarr:latest
