# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000

# Host bind mounts (absolute paths). Use: docker compose --env-file stack.env up -d
WHISPARR_CONFIG_PATH=/path/to/whisparr/config
WHISPARR_MOVIES_PATH=/path/to/whisparr/library
WHISPARR_USENET_DOWNLOADS_PATH=/path/to/usenet/completed
WHISPARR_TORRENT_DOWNLOADS_PATH=/path/to/torrents/completed
