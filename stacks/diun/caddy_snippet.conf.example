# Diun — split-horizon + public TLS: diun.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

diun.home, diun.local {
	tls internal
	reverse_proxy diun:80 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://diun.example.com {
	reverse_proxy diun:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

diun.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy diun:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
