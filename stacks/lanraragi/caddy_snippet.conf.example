# LANraragi — split-horizon + public TLS: lanraragi.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

lanraragi.home, lanraragi.local {
	tls internal
	reverse_proxy lanraragi:3000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://lanraragi.example.com {
	reverse_proxy lanraragi:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

lanraragi.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy lanraragi:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
