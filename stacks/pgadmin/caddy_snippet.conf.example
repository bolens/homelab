# pgAdmin — split-horizon + public TLS: pgadmin.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).
# Prefer Cloudflare Access if exposed.

pgadmin.home, pgadmin.local {
	tls internal
	reverse_proxy pgadmin:80 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://pgadmin.example.com {
	reverse_proxy pgadmin:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

pgadmin.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy pgadmin:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
