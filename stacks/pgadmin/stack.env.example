# pgAdmin 4 — PostgreSQL admin UI.
# Copy to stack.env and set real values. Do NOT commit real credentials.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
#
# Docs: https://www.pgadmin.org/  |  https://hub.docker.com/r/dpage/pgadmin4

# Login credentials for the pgAdmin web UI
PGADMIN_DEFAULT_EMAIL=admin@example.com
# Generate with: openssl rand -base64 24
PGADMIN_DEFAULT_PASSWORD=changeme
