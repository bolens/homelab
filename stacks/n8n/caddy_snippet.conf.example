# n8n — split-horizon + public TLS: n8n.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

n8n.home, n8n.local {
	tls internal
	reverse_proxy n8n:5678 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://n8n.example.com {
	reverse_proxy n8n:5678 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

n8n.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy n8n:5678 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
