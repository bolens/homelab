# n8n – workflow automation. Copy to stack.env and set N8N_HOST + WEBHOOK_URL.
# Docs: https://docs.n8n.io/hosting/

# Required when behind Caddy: hostname and full webhook base URL (no trailing path).
# Examples: https://n8n.home  https://n8n.yourdomain.com
N8N_HOST=
WEBHOOK_URL=

# Protocol when behind HTTPS reverse proxy (default https).
# N8N_PROTOCOL=https

# Optional: set a fixed encryption key so credentials survive volume recreation.
# Generate with: openssl rand -hex 32
# N8N_ENCRYPTION_KEY=

# Restart approval workflow. Generate the gateway bearer token with:
# openssl rand -hex 32
N8N_RESTART_GATEWAY_TOKEN=replace-with-openssl-rand-hex-32

# Comma-separated Docker container names the restart gateway may restart.
# Start with stateless applications. Do not add n8n, this gateway, Caddy,
# databases, storage, or notification/monitoring dependencies.
N8N_RESTART_ALLOWLIST=sonarr,radarr,prowlarr,bazarr

# Seconds Docker waits for a container to stop cleanly before killing it.
N8N_RESTART_TIMEOUT_SECONDS=30

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
# Harbor fallback: N8N_RESTART_GATEWAY_IMAGE=harbor.bolens.dev/homelab/n8n-restart-gateway:latest
