          "format": "table",
          "instant": true,
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Top Services by Estimated Drop Gap (5m)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "Time": true,
              "job": true
            },
            "indexByName": {
              "Value": 2,
              "service": 1
            },
            "renameByName": {
              "Value": "estimated_drop_gap_per_sec",
              "service": "service"
            }
          }
        }
      ],
      "type": "table"
    },
