# OpenGist — split-horizon + public TLS: opengist.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

opengist.home, opengist.local {
	tls internal
	reverse_proxy opengist:6157 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://opengist.example.com {
	reverse_proxy opengist:6157 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

opengist.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy opengist:6157 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
