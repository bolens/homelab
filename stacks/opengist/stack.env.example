# OpenGist — copy to stack.env and adjust as needed.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
#
# Docs: https://github.com/thomiceli/opengist

# Container user for file ownership on bind mounts / volumes (run: id -u && id -g on the host)
PUID=1000
PGID=1000

# Directory for OpenGist config (container path — matches compose mount target)
OPENGIST_CONFIG_DIR=/config

# Host path for OpenGist config directory (bind mount source)
OPENGIST_CONFIG_DIR_ON_HOST=/home/youruser/.config/opengist
