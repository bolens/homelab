# backrest - private local configuration from this example.
TZ=Etc/UTC
BACKREST_PORT=0.0.0.0:9898
BACKREST_DATA=/data
BACKREST_CONFIG=/config/config.json
BACKREST_RESTIC_COMMAND=/bin/restic
XDG_CACHE_HOME=/cache
TMPDIR=/tmp
# Optional repository override only; must already exist on the intended disk.
RESTIC_REPOSITORY_PATH=/srv/backups/restic
