# Zimi: authenticated local library and management.
TZ=Etc/UTC
ZIM_DIR=/zims
ZIMI_DATA_DIR=/config
ZIMI_MANAGE=1
ZIMI_MANAGE_USER=admin
ZIMI_MANAGE_PASSWORD=REPLACE_WITH_GENERATED_ADMIN_PASSWORD
ZIMI_MANAGE_OPEN=0
ZIMI_LAN_ADMIN=0
ZIMI_PUBLIC_ACCESS=private
# Catalog/manual HTTP downloads remain available. Automatic content work is off.
ZIMI_AUTO_UPDATE=0
ZIMI_BT=off
ZIMI_NEARBY=off
ZIMI_UPDATE_CHECK=never
ZIMI_VOICE_DOWNLOADS=never
ZIMI_SATELLITE_UPDATES=never
