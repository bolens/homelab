# Local aliases and opt-in public examples. No host ports are published.
zimi.home.arpa, zimi.local {
    tls internal
    reverse_proxy zimi:8899 {
        transport http {
            versions 1.1
        }
    }
}

http://zimi.example.com {
    reverse_proxy zimi:8899 {
        header_up X-Forwarded-Proto https
        transport http {
            versions 1.1
        }
    }
}

zimi.example.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    reverse_proxy zimi:8899 {
        transport http {
            versions 1.1
        }
    }
}
