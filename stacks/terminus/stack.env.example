# TRMNL Terminus – self-hosted backend for TRMNL e-paper devices
# Copy to stack.env and set values. Do NOT commit real secrets.
# Upstream compose: https://github.com/usetrmnl/terminus/blob/main/compose.yml

# -----------------------------------------------------------------------------
# Public URL (must match Caddy hostname; devices and clients use this)
# -----------------------------------------------------------------------------
API_URI=https://terminus.example.com

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Hanami HTTP port inside the container (Caddy must target the same port).
HANAMI_PORT=2300
# Rails/Hanami secret: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_GENERATED_SECRET
# First deploy: true runs setup/migrations. Set to false after the app is configured if upstream recommends it.
APP_SETUP=true

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_USER=terminus
DATABASE_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
DATABASE_NAME=terminus

# -----------------------------------------------------------------------------
# Valkey (Redis-compatible)
# -----------------------------------------------------------------------------
KEYVALUE_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
# Logical Redis DB index (default 0)
KEYVALUE_DATABASE=0

# -----------------------------------------------------------------------------
# Optional: extra PEM URLs for init-certificates (comma-separated)
# -----------------------------------------------------------------------------
# CERTIFICATE_URLS=

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
