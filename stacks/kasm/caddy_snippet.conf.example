# Kasm Workspaces — split-horizon + public TLS: kasm.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).
# Upstream speaks HTTPS on 443 inside the container.

kasm.home, kasm.local {
	tls internal
	reverse_proxy https://kasm:443 {
		header_up Host {host}
		flush_interval -1
		transport http {
			tls_insecure_skip_verify
		}
	}
}

http://kasm.example.com {
	reverse_proxy https://kasm:443 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		flush_interval -1
		transport http {
			tls_insecure_skip_verify
		}
	}
}

kasm.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy https://kasm:443 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		flush_interval -1
		transport http {
			tls_insecure_skip_verify
		}
	}
}
