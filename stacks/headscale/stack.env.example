# Headscale – copy to stack.env. The preparation script creates the config file
# from config.example.yaml without overwriting an existing file.

# -----------------------------------------------------------------------------
# Config bind mount (required)
# -----------------------------------------------------------------------------
# Use an absolute path for Portainer. ${HOME} works with Docker Compose CLI.
HEADSCALE_CONFIG_PATH=${HOME}/.config/headscale/config.yaml

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
