# Headscale — split-horizon + public TLS: headscale.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

headscale.home, headscale.local {
	tls internal
	reverse_proxy headscale:8080 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://headscale.example.com {
	reverse_proxy headscale:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

headscale.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy headscale:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
