# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000

# Optional: set URL base if you reverse proxy Sonarr under a path
# SONARR__InstanceName=Sonarr
# SONARR__BindAddress=*
# SONARR__Port=8989


# Media library bind mount (host → /tv in container)
SONARR_TV_PATH=/mnt/unraid/media/tv

# Usenet downloads bind mount (host → /downloads; shared with NZBGet)
SONARR_USENET_DOWNLOADS_PATH=/mnt/unraid/media/downloads/usenet
