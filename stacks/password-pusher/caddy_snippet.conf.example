# Password Pusher — split-horizon + public TLS: pwpush.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

pwpush.home, pwpush.local {
	tls internal
	reverse_proxy pwpush:5100 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://pwpush.example.com {
	reverse_proxy pwpush:5100 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

pwpush.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy pwpush:5100 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
