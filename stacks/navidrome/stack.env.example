# Navidrome – copy to stack.env. Optional: set TZ and ND_* options.
#
# See documents/ENV-VARS.md and Navidrome configuration options:
#   https://navidrome.org/docs/usage/configuration/options/
#

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# -----------------------------------------------------------------------------
# Navidrome options (all optional)
# -----------------------------------------------------------------------------

# Base URL when running behind a reverse proxy. Use your full Navidrome URL,
# for example: https://music.yourdomain.com
# ND_BASEURL=
# Host path for your music library bind-mounted to /music in the container.
NAVIDROME_MUSIC_PATH=/mnt/unraid/media/music

# Log level: trace, debug, info, warn, error
# ND_LOGLEVEL=info

# Library rescan schedule (cron-style or duration, e.g. 1h, 24h)
# ND_SCANSCHEDULE=1h

# -----------------------------------------------------------------------------
# Last.fm scrobbling (required for "Scrobble to Last.fm" in user settings)
# -----------------------------------------------------------------------------
#
# 1) Create a Last.fm API app: https://www.last.fm/api/account/create
# 2) Copy API Key and Shared Secret below.
# 3) Restart Navidrome and then enable Last.fm scrobbling in each user's profile.
#
# ND_LASTFM_ENABLED=true
# ND_LASTFM_APIKEY=***
# ND_LASTFM_SECRET=***

