# Navidrome — split-horizon + public TLS: music.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

navidrome.home, navidrome.local {
	tls internal
	reverse_proxy navidrome:4533 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://music.example.com {
	reverse_proxy navidrome:4533 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

music.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy navidrome:4533 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
