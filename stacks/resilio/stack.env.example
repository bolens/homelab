# Resilio Sync — copy to stack.env and adjust as needed.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Host user/group IDs — ensures files created in bind-mounted volumes are owned by your host user.
# Run: id -u && id -g
PUID=1000
PGID=1000

# Optional: custom umask for file permissions
UMASK=022
