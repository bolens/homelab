# Gitea — split-horizon + public TLS: gitea.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).
# Set GITEA__server__ROOT_URL (stack.env) to the URL you use.

gitea.home, gitea.local {
	tls internal
	reverse_proxy gitea:3000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://gitea.example.com {
	reverse_proxy gitea:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

gitea.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy gitea:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
