# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000


# Media library bind mounts (host → /data/... in container)
JELLYFIN_TV_PATH=/path/to/media/tv
JELLYFIN_MOVIES_PATH=/path/to/media/movies
JELLYFIN_MUSIC_PATH=/path/to/media/music
JELLYFIN_AUDIOBOOKS_PATH=/path/to/media/audiobooks
# Use the scanner-safe Calibre export, not Calibre's live database tree.
JELLYFIN_BOOKS_PATH=/path/to/media/kavita-books
