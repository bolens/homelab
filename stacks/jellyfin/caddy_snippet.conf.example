# Jellyfin — split-horizon + public TLS: jellyfin.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

jellyfin.home, jellyfin.local {
	tls internal
	reverse_proxy jellyfin:8096 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://jellyfin.example.com {
	reverse_proxy jellyfin:8096 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

jellyfin.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy jellyfin:8096 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
