# Calibre-Web — split-horizon + public TLS: calibre-web.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

calibre-web.home, calibre-web.local {
	tls internal
	reverse_proxy calibre-web:8083 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://calibre-web.example.com {
	reverse_proxy calibre-web:8083 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

calibre-web.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy calibre-web:8083 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
