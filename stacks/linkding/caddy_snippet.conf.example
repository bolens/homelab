# Linkding — split-horizon + public TLS: linkding.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

linkding.home, linkding.local {
	tls internal
	reverse_proxy linkding:9090 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://linkding.example.com {
	reverse_proxy linkding:9090 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

linkding.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy linkding:9090 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
