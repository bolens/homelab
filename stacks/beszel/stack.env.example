# Beszel Hub – required and optional environment variables
#
# Public URL users and agents use to reach the hub (scheme + host, no trailing slash).
# Must match the hostname in Caddy / your tunnel (e.g. https://beszel.example.com).
BESZEL_APP_URL=https://beszel.example.com

# Persistent data directory on the host (bind mount → /beszel_data).
# Compose reads variables from shell or from `.env`; run ./prepare-stack.sh to link .env → stack.env.
BESZEL_DATA_DIR=${HOME}/.local/share/beszel

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
