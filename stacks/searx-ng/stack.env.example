# Base URL where SearXNG is served (used for result links and UI).
# Examples: https://searx-ng.home/ or https://searx-ng.yourdomain.com/
SEARXNG_BASE_URL=https://searx-ng.home/

# Secret key (required). Generate with: openssl rand -hex 32
# When deploying as a stack in Portainer, set this in the stack's environment.
SEARXNG_SECRET=change-me-use-openssl-rand-hex-32

# Path to SearXNG settings.yml on the host (Compose bind mount only; the container uses /etc/searxng/settings.yml).
# prepare-stack.sh will create/copy this file from settings.yml.example when missing.
SEARXNG_SETTINGS_PATH=${HOME}/.config/searx-ng/settings.yml

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
