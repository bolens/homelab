# ntfy — split-horizon + public TLS: ntfy.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).
# Set NTFY_BASE_URL in stack.env to your public URL.

ntfy.home, ntfy.local {
	tls internal
	reverse_proxy ntfy:80 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://ntfy.example.com {
	reverse_proxy ntfy:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

ntfy.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy ntfy:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
