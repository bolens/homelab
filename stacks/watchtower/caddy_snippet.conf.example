# Watchtower HTTP API (manual POST /v1/update) — split-horizon + public TLS: watchtower.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

watchtower.home, watchtower.local {
	tls internal
	reverse_proxy watchtower:80 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://watchtower.example.com {
	reverse_proxy watchtower:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

watchtower.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy watchtower:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
