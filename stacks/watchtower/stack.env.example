# Watchtower – image update automation
#
# The stack sets sensible defaults in docker-compose.yml. Use this file if you
# want to tweak poll interval, label behavior, or timezone. Copy to stack.env and
# adjust values as needed; then update the compose to reference ${VAR} if you
# prefer env-driven configuration.

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Check for updates every N seconds (default: 86400 = 24h)
WATCHTOWER_POLL_INTERVAL=86400

# Remove old images after updating (saves disk space)
WATCHTOWER_CLEANUP=true

# Only update containers with label com.centurylinklabs.watchtower.enable=true
# Set to "true" to enable label filtering; "false" = update all containers
WATCHTOWER_LABEL_ENABLE=false

# Required when HTTP API is enabled (docker-compose): Bearer token for POST /v1/update and GET /v1/metrics
# Bearer token for Watchtower HTTP API (POST /v1/update). Regenerate: openssl rand -hex 24
WATCHTOWER_HTTP_API_TOKEN=***

# ntfy push notification URL (generic+ webhook scheme).
# Format: generic+https://ntfy.example.com/watchtower
# Leave blank to disable notifications.
WATCHTOWER_NOTIFICATION_URL=generic+https://ntfy.example.com/watchtower

# Send a notification report after every run, even if nothing was updated.
# Without this, watchtower is silent when all containers are already current.
# WATCHTOWER_NOTIFICATION_REPORT=true
