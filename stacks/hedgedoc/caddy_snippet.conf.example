# HedgeDoc — split-horizon + public TLS: hedgedoc.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

hedgedoc.home, hedgedoc.local {
	tls internal
	reverse_proxy hedgedoc:3000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://hedgedoc.example.com {
	reverse_proxy hedgedoc:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

hedgedoc.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy hedgedoc:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
