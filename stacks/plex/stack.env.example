# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000

# VERSION should usually be "docker"
VERSION=docker

# Direct TCP port used by Plex native Remote Access.
PLEX_REMOTE_PORT=32400

# Optional: Plex claim token (only needed on first run to link your server)
# Obtain from https://www.plex.tv/claim and paste here, then remove after the server is claimed.
# PLEX_CLAIM=REPLACE_WITH_PLEX_CLAIM_TOKEN


# Media library bind mounts (host → /data/... in container)
PLEX_TV_PATH=/path/to/media/tv
PLEX_MOVIES_PATH=/path/to/media/movies
PLEX_MUSIC_PATH=/path/to/media/music
# Optional: PLEX_PHOTOS_PATH=/path/to/media/photos
