# Mattermost
# Copy to stack.env and customize. Do NOT commit secrets.
#
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

POSTGRES_DB=mattermost
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD

# Must match public Caddy URL.
MM_SERVICESETTINGS_SITEURL=https://mattermost.example.com
