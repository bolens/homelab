# DDNS Updater – optional env overrides (image defaults apply when unset).
# Copy to stack.env and adjust. Secrets belong in stack.env (gitignored), not in compose.

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Optional: entire JSON config as one line (overrides data/config.json when set)
# CONFIG={"settings":[{"provider":"duckdns","domain":"yourhost.duckdns.org","token":"REPLACE_ME"}]}

# Optional knobs (see upstream README)
# PERIOD=5m
# UPDATE_COOLDOWN_PERIOD=5m
# LOG_LEVEL=info
# SERVER_ENABLED=yes
# LISTENING_ADDRESS=:8000
# ROOT_URL=/
# SHOUTRRR_ADDRESSES=
# RESOLVER_ADDRESS=
