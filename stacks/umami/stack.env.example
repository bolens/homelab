# Umami – copy to stack.env and set secrets. Do NOT commit stack.env.
#
# Docs: https://umami.is/docs/

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# PostgreSQL password (must match the password embedded in DATABASE_URL below).
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD

# Postgres role and database name (defaults match Umami docs).
POSTGRES_DB=umami
POSTGRES_USER=umami

# Connection string for the Umami app container. Host must be `db` (compose service name).
# Use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://umami:REPLACE_WITH_GENERATED_PASSWORD@db:5432/umami

# Session signing secret (min ~32 chars recommended).
# Generate: openssl rand -base64 32
APP_SECRET=REPLACE_WITH_APP_SECRET

# -----------------------------------------------------------------------------
# Optional overrides
# -----------------------------------------------------------------------------

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
