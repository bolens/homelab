# Seafile – self-hosted file sync and sharing
# Copy to stack.env and customize. Do NOT commit real secrets.
#
# Docs:
# - Seafile: https://www.seafile.com/
# - Docker: https://manual.seafile.com/14.0/setup/setup_ce_by_docker/

# -----------------------------------------------------------------------------
# Database (MariaDB)
# -----------------------------------------------------------------------------

# Root password for MariaDB (required).
# Generate with: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=REPLACE_WITH_GENERATED_ROOT_PASSWORD

# Seafile DB credentials.
SEAFILE_DB_NAME=seafile
SEAFILE_DB_USER=seafile
# Generate with: openssl rand -base64 24
SEAFILE_DB_PASSWORD=REPLACE_WITH_GENERATED_DB_PASSWORD

# -----------------------------------------------------------------------------
# Seafile server
# -----------------------------------------------------------------------------

# Public hostname used by Seafile (must match your Caddy URL).
# Example: seafile.yourdomain.com
SEAFILE_SERVER_HOSTNAME=seafile.yourdomain.com

# Caddy terminates TLS; Seafile generates public HTTPS URLs.
SEAFILE_SERVER_PROTOCOL=https

# Required application signing key. Generate with: openssl rand -hex 32
# Keep the original key on upgrades; changing it can invalidate integrations.
JWT_PRIVATE_KEY=REPLACE_WITH_GENERATED_JWT_KEY

# Fresh installs only. Existing administrators are not reset by these variables.
INIT_SEAFILE_ADMIN_EMAIL=admin@example.com
INIT_SEAFILE_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_ADMIN_PASSWORD

# Preserve the names used by the existing installation on upgrades.
SEAFILE_MYSQL_DB_CCNET_DB_NAME=ccnet_db
SEAFILE_MYSQL_DB_SEAFILE_DB_NAME=seafile_db
SEAFILE_MYSQL_DB_SEAHUB_DB_NAME=seahub_db

# Redis is an authenticated, non-persistent cache on the private stack network.
# Generate with: openssl rand -hex 32 (no shell/Compose quoting required).
REDIS_PASSWORD=REPLACE_WITH_GENERATED_REDIS_PASSWORD

# Seafile 14 moves the WebDAV switch/workers from seafdav.conf into the env.
ENABLE_SEAFDAV=false
SEAFDAV_WORKERS=5

# Optional external metadata server, not provisioned by this base stack.
# If already enabled, migrate its existing settings before deployment.
ENABLE_METADATA_MANAGEMENT=False
INNER_METADATA_SERVER_URL=http://seafile-md-server:8084

# TIME_ZONE may be supplied explicitly; otherwise the Compose default applies.
