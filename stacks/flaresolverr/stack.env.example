# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
LOG_LEVEL=info
# Optional: write logs to file inside the volume
# LOG_FILE=/config/flaresolverr.log
# Optional outbound proxy for all requests (per-request proxy in API overrides this)
# PROXY_URL=http://proxy.example.com:8080
# PROXY_USERNAME=
# PROXY_PASSWORD=
# Browser / challenge tuning (see upstream README)
# HEADLESS=true
# DISABLE_MEDIA=false
# TEST_URL=https://www.google.com
# Prometheus metrics on port 8192 (scrape http://flaresolverr:8192/metrics when enabled)
# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=8192
