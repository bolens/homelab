# Review authentication before enabling a public hostname. No host ports are published, except Music Assistant host networking.
komodo.home.arpa, komodo.local {
    tls internal
    reverse_proxy komodo-core:9120 {
        transport http {
            versions 1.1
        }
    }
}

http://komodo.example.com {
    reverse_proxy komodo-core:9120 {
        header_up X-Forwarded-Proto https
        transport http {
            versions 1.1
        }
    }
}

komodo.example.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    reverse_proxy komodo-core:9120 {
        transport http {
            versions 1.1
        }
    }
}
