# Vaultwarden — split-horizon + public TLS: vaultwarden.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

vaultwarden.home, vaultwarden.local {
	tls internal
	reverse_proxy vaultwarden:80 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://vaultwarden.example.com {
	reverse_proxy vaultwarden:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

vaultwarden.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy vaultwarden:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
