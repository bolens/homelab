# Homarr — split-horizon + public TLS: homarr.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

homarr.home, homarr.local {
	tls internal
	reverse_proxy homarr:7575 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://homarr.example.com {
	reverse_proxy homarr:7575 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

homarr.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy homarr:7575 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
