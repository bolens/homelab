# Review authentication before enabling a public hostname. No host ports are published, except Music Assistant host networking.
termix.home.arpa, termix.local {
    tls internal
    reverse_proxy termix:8080 {
        transport http {
            versions 1.1
        }
    }
}

http://termix.example.com {
    reverse_proxy termix:8080 {
        header_up X-Forwarded-Proto https
        transport http {
            versions 1.1
        }
    }
}

termix.example.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    reverse_proxy termix:8080 {
        transport http {
            versions 1.1
        }
    }
}
