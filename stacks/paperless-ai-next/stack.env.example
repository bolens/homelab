# Paperless-AI next connection to Paperless-ngx
PAPERLESS_API_URL=http://paperless-ngx:8000
# Find this in Paperless-ngx: User Dropdown -> My Profile
PAPERLESS_API_TOKEN=change-me-paperless-api-token
PAPERLESS_USERNAME=example

PROCESS_PREDEFINED_DOCUMENTS=no
TAGS=
IGNORE_TAGS=
ADD_AI_PROCESSED_TAG=yes
AI_PROCESSED_TAG_NAME=ai-processed
DISABLE_AUTOMATIC_PROCESSING=no
SCAN_INTERVAL=*/30 * * * *

# Public URL used for links
PAPERLESS_PUBLIC_URL=https://paperless.example.com
PAPERLESS_BASE_URL=http://paperless-ngx:8000

# Shared Ollama backend (same ai-backend network)
OLLAMA_API_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:latest

# Stack defaults
PAPERLESS_AI_PORT=3000
AI_PROVIDER=ollama
ALLOW_REMOTE_SETUP=yes
TRUST_PROXY=1
COOKIE_SECURE_MODE=auto
LOG_LEVEL=info

MISTRAL_OCR_ENABLED=no
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
