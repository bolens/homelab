# Store the real file outside Git with mode 0600.
# Use an immutable reviewed image or a local tag verified against the accepted image ID.
WOODPECKER_GUEST_AGENT_IMAGE=
WOODPECKER_SERVER=ci.example.net:443
WOODPECKER_AGENT_SECRET_PATH=/path/to/private/agent-token
WOODPECKER_GRPC_SECURE=true
WOODPECKER_HOSTNAME=isolated-ci-qualification
WOODPECKER_AGENT_LABELS=node=isolated-qualification
WOODPECKER_MAX_WORKFLOWS=1
