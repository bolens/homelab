# Woodpecker CI — split-horizon + public TLS: woodpecker.example.com and ci.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

woodpecker.home, ci.home, woodpecker.local, ci.local {
	tls internal
	reverse_proxy woodpecker-server:8000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://woodpecker.example.com {
	reverse_proxy woodpecker-server:8000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

woodpecker.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy woodpecker-server:8000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://ci.example.com {
	reverse_proxy woodpecker-server:8000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

ci.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy woodpecker-server:8000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

# Optional publisher broker: do not add its route by default. After preparing and
# reviewing the broker, import publisher-broker/caddy_routes.conf.example and use
# its publisher-credentials snippet in the one configured HTTPS site instead of
# that site's bare reverse_proxy. See publisher-broker/README.md.
