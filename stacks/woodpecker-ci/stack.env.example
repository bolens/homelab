# Woodpecker CI – lightweight CI/CD server and agent
# Copy to stack.env and customize. Do NOT commit real secrets.
#
# All values below are read from stack.env into the containers (no Compose
# host interpolation). Use the same generated password in POSTGRES_PASSWORD
# and inside WOODPECKER_DATABASE_DATASOURCE (replace REPLACE_DB_PASSWORD).
#
# Docs:
# - Website: https://woodpecker-ci.org/
# - Docs: https://woodpecker-ci.org/docs/

# -----------------------------------------------------------------------------
# PostgreSQL (official image — postgres service)
# -----------------------------------------------------------------------------

POSTGRES_DB=woodpecker
POSTGRES_USER=woodpecker
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD

# -----------------------------------------------------------------------------
# Woodpecker server — database (same password as POSTGRES_PASSWORD)
# -----------------------------------------------------------------------------

WOODPECKER_DATABASE_DRIVER=postgres
# Host must be the DB container name `woodpecker-postgres` (not `postgres` — the
# server is also on the `monitor` network where another `postgres` may exist and
# steal DNS). Use the same password as
# POSTGRES_PASSWORD; if it contains @ : / ? # [ ] & etc., URL-encode it in this URL only
# (e.g. `python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$PASS"`).
WOODPECKER_DATABASE_DATASOURCE=postgres://woodpecker:REPLACE_DB_PASSWORD@woodpecker-postgres:5432/woodpecker?sslmode=disable

# -----------------------------------------------------------------------------
# Gitea integration
# -----------------------------------------------------------------------------

# URL of your Gitea instance (public URL behind Caddy).
# Example: https://gitea.yourdomain.com
WOODPECKER_GITEA_URL=https://gitea.yourdomain.com

# OAuth client ID/secret from Gitea (created as an OAuth2 app).
WOODPECKER_GITEA_CLIENT=REPLACE_WITH_GITEA_CLIENT_ID
WOODPECKER_GITEA_SECRET=REPLACE_WITH_GITEA_CLIENT_SECRET

WOODPECKER_GITEA=true

# Allow self-service repo activation / login.
WOODPECKER_OPEN=false

# -----------------------------------------------------------------------------
# Agent / server
# -----------------------------------------------------------------------------

# Shared secret between server and agents (required).
# Generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=REPLACE_WITH_GENERATED_AGENT_SECRET

# Server address used by agents to reach the server (inside Docker).
WOODPECKER_SERVER=woodpecker-server:9000

# Optional: public URL of Woodpecker (OAuth redirects); set to your Caddy URL.
# WOODPECKER_HOST=https://ci.yourdomain.com

# Optional timezone (or use shared.env pattern from documents/SHARED-RESOURCES.md)
# TZ=America/Denver
