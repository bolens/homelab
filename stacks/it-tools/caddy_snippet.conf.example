# it-tools — split-horizon + public TLS: it-tools.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

it-tools.home, it-tools.local {
	tls internal
	reverse_proxy it-tools:8080 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://it-tools.example.com {
	reverse_proxy it-tools:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

it-tools.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy it-tools:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
