# Zigbee2MQTT — split-horizon + public TLS: zigbee2mqtt.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

zigbee2mqtt.home, zigbee2mqtt.local {
	tls internal
	reverse_proxy zigbee2mqtt:8080 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://zigbee2mqtt.example.com {
	reverse_proxy zigbee2mqtt:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

zigbee2mqtt.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy zigbee2mqtt:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
