# DocuSeal – template for `stack.env` / `.env` / Portainer “Environment”
#
# Portainer: Stacks → Add stack → Web editor → paste docker-compose.yml → scroll to
# “Environment variables” and add each REQUIRED line below (same names and values).
# Do not commit real secrets.
#
# CLI from this directory: ./prepare-stack.sh then edit stack.env; prepare copies stack.env -> .env
# so `docker compose up -d` interpolates variables without `--env-file`.
#
# Docs: https://www.docuseal.com/docs/configuring-docuseal-via-environment-variables
# Image: https://hub.docker.com/r/docuseal/docuseal

# -----------------------------------------------------------------------------
# PostgreSQL (must match credentials inside DATABASE_URL below)
# -----------------------------------------------------------------------------

POSTGRES_USER=docuseal
POSTGRES_DB=docuseal
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_DB_PASSWORD

# -----------------------------------------------------------------------------
# DocuSeal / Rails (required)
# -----------------------------------------------------------------------------

# Public hostname only (no https://) — must match your Caddy vhost.
HOST=docuseal.example.com

# Optional; defaults to HOST when unset (TLS terminated at Caddy).
# FORCE_SSL=docuseal.example.com

# Required. Generate with: openssl rand -hex 64
SECRET_KEY_BASE=REPLACE_WITH_OPENSSL_RAND_HEX_64

# Same password as POSTGRES_PASSWORD; user must match POSTGRES_USER / POSTGRES_DB / host.
DATABASE_URL=postgresql://docuseal:REPLACE_WITH_GENERATED_DB_PASSWORD@postgres:5432/docuseal

# -----------------------------------------------------------------------------
# Optional: outbound mail (add in Portainer only if you use SMTP; see README)
# -----------------------------------------------------------------------------

# SMTP_ADDRESS=smtp-relay
# SMTP_PORT=587
# SMTP_DOMAIN=example.com
# SMTP_AUTHENTICATION=plain
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_ENABLE_STARTTLS=true

# TZ/locale: optional ../../shared.env from repo root, or set TZ in Portainer / .env
