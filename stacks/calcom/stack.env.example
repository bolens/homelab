# Cal.com — self-hosted scheduling.
# Copy to stack.env and set real values. Do NOT commit real credentials.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
#
# Docs: https://cal.com/docs/self-hosting/docker

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=calcom
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=changeme
POSTGRES_DB=calendso

# Database URLs (substitute the same password used above)
DATABASE_URL=postgresql://calcom:changeme@calcom-db:5432/calendso
DATABASE_DIRECT_URL=postgresql://calcom:changeme@calcom-db:5432/calendso
# Required by scripts/start.sh (wait-for-it before Prisma migrate)
DATABASE_HOST=calcom-db:5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Format: redis://<user>:<password>@<host>
REDIS_URL=redis://calcom-redis:changeme@calcom-redis

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_FROM_NAME="Cal.com (homelab)"

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Suppress getDeploymentKey startup errors in self-hosted mode.
# Generate with: openssl rand -hex 32
CAL_SIGNATURE_TOKEN=changeme

# ---------------------------------------------------------------------------
# Web push (removes "Missing VAPID keys" warning)
# Generate a VAPID key pair with: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
