# tailscale-exporter — Headscale Prometheus exporter.
# Copy to stack.env and set real values. Do NOT commit real credentials.
#
# Docs: https://github.com/davidsbond/tailscale-exporter

# gRPC address of your Headscale server (service name:port within the Docker network)
HEADSCALE_ADDRESS=headscale:50443

# Headscale API key — generate in Headscale admin: headscale apikeys create
HEADSCALE_API_KEY=changeme

# Set to 'true' to skip TLS verification for the Headscale gRPC connection.
# Not recommended in production.
HEADSCALE_INSECURE=false
