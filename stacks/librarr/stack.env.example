# Copy to stack.env; keep private credentials out of Git.
TZ=UTC
# These set Compose user:, not an upstream PUID/PGID feature.
PUID=1000
PGID=1000
# Local storage for SQLite and private UI settings. Sources use ./sources.json.
LIBRARR_CONFIG_PATH=/path/to/appdata/librarr
# Same host root as QBITTORRENT_MEDIA_PATH; existing remote mount required.
LIBRARR_MEDIA_PATH=/path/to/media
AUTH_USERNAME=your-admin-user
AUTH_PASSWORD=replace-me-with-a-unique-password
# Generate each key separately: openssl rand -hex 32
API_KEY=replace-me-with-a-random-key
TORZNAB_API_KEY=replace-me-with-a-different-random-key

# Optional Prowlarr -> Librarr searches. Do not add Librarr back to Prowlarr.
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=
# Optional qBittorrent (shares Gluetun's network namespace on torrents).
# TORRENT_CLIENT=qbittorrent
# QB_URL=http://gluetun:8080
# QB_USER=
# QB_PASS=

# Optional Z-Library. Supply an endpoint you have independently verified.
ZLIBRARY_ENABLED=false
# ZLIBRARY_URL=https://your-verified-provider.example
# ZLIBRARY_EMAIL=
# ZLIBRARY_PASSWORD=

# Select docker-compose.readers.yml before enabling these reader API calls.
# Readers consume the organized paths directly; leave *_LIBRARY_PATH unset
# to avoid duplicate copies. IDs must identify only the intended libraries.
# KAVITA_URL=http://kavita:5000
# KAVITA_USER=
# KAVITA_PASS=
# KAVITA_EBOOK_LIBRARY_ID=
# KAVITA_MANGA_LIBRARY_ID=
# KOMGA_URL=http://komga:25600
# KOMGA_USER=
# KOMGA_PASS=
# KOMGA_LIBRARY_ID=
# ABS_URL=http://audiobookshelf:80
# ABS_TOKEN=
# ABS_LIBRARY_ID=
# KAVITA_PUBLIC_URL=https://kavita.yourdomain.com
# ABS_PUBLIC_URL=https://audiobookshelf.yourdomain.com

# Optional link to Calibre-Web; does not register files in metadata.db.
# CALIBRE_URL=https://calibre-web.yourdomain.com
# Do not set CALIBRE_LIBRARY_PATH to an existing managed Calibre library.
# UI-saved settings override environment variables after a restart; see README.

# Optional docker-compose.flood.yml: restricted Transmission RPC to rTorrent.
# Generate BRIDGE_PASSWORD independently: openssl rand -hex 32
# BRIDGE_USER=librarr
# BRIDGE_PASSWORD=replace-with-a-unique-random-password
# FLOOD_RTORRENT_VOLUME=flood_rtorrent_data
# FLOOD_UID=1001
# FLOOD_GID=1001
