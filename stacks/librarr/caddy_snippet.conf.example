# Librarr — split-horizon + public TLS: librarr.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

librarr.home, librarr.local {
	tls internal
	reverse_proxy librarr:5050 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://librarr.example.com {
	reverse_proxy librarr:5050 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

librarr.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy librarr:5050 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
