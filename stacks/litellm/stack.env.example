# LiteLLM proxy — https://docs.litellm.ai/docs/proxy/virtual_keys
# Copy to stack.env (or run ./prepare-stack.sh). Do NOT commit stack.env.
#
# Host path to proxy YAML (read-only in container as /app/config.yaml).
# prepare-stack.sh creates the file from litellm_config.yaml.example when missing.
LITELLM_CONFIG_FILE=${HOME}/.config/litellm/config.yaml
#
# Master key for Admin UI / Virtual key management (treat like a root API key).
# Generate: openssl rand -hex 24
LITELLM_MASTER_KEY=sk-homelab-change-me

# Admin UI (https://docs.litellm.ai/docs/proxy/ui) — required; the container reads these from stack.env only.
# Use the same value as LITELLM_MASTER_KEY for the password if you want one secret for both API and UI.
UI_USERNAME=admin
UI_PASSWORD=REPLACE_WITH_GENERATED_UI_PASSWORD

# Postgres (bundled `litellm-postgres` service). Admin UI login needs a DB — without it you see “Not connected to DB!”.
# Generate: openssl rand -base64 24  (avoid @ : / ? # in the password; they break DATABASE_URL parsing)
POSTGRES_USER=litellm
POSTGRES_DB=litellm
POSTGRES_PASSWORD=change-me-postgres-password

# Optional: only if you removed the bundled postgres service and point LiteLLM at your own Postgres instead.
# DATABASE_URL=postgresql://user:pass@host:5432/litellm

# Optional cloud provider keys (reference in litellm_config.yaml with os.environ/VAR)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# TZ/locale: use ../../shared.env (see documents/SHARED-RESOURCES.md)
