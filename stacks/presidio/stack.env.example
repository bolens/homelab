# Presidio — PII detection and anonymization API.
# Copy to stack.env and adjust as needed.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
#
# Docs: https://microsoft.github.io/presidio/

# Optional: number of Gunicorn workers per service (default: 1)
# PRESIDIO_WORKERS=1

# Optional: if the Ollama stack is running and you want the analyzer to use it for NER,
# set the Ollama base URL. Both stacks must share the ingress-admin network.
OLLAMA_HOST=http://ollama:11434
