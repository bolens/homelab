# Copy to stack.env and adjust as needed.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
DISPATCHARR_LOG_LEVEL=info

# Optional docker-compose.plex.yml: localhost-only port for host-networked Plex.
# Keep this private; the browser UI uses Caddy, and Plex uses the local tuner.
DISPATCHARR_PLEX_PORT=9191
# docker-compose.library-artwork.yml reuses this binding for its private guide.
# Plex 1.43.5+ requires publicly reachable provider images. Publish only the
# reviewed image paths through the existing HTTPS hostname, with no new port.
DISPATCHARR_LIBRARY_ARTWORK_ORIGIN=https://dispatcharr.example.com

# Optional docker-compose.storage.yml: verify the remote filesystem before
# creating this directory. Compose refuses to create a missing bind source.
DISPATCHARR_RECORDINGS_PATH=/path/to/media/dvr/dispatcharr
