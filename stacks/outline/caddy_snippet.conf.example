# Outline — split-horizon + public TLS: outline.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

outline.home, outline.local {
	tls internal
	reverse_proxy outline:3000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://outline.example.com {
	reverse_proxy outline:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

outline.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy outline:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
