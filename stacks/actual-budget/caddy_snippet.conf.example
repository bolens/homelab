# Actual Budget — split-horizon + public TLS: actual-budget.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

actual-budget.home, actual-budget.local {
	tls internal
	reverse_proxy actual-budget:5006 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://actual-budget.example.com {
	reverse_proxy actual-budget:5006 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

actual-budget.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy actual-budget:5006 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
