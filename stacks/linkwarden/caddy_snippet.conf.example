# Linkwarden — split-horizon + public TLS: linkwarden.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

linkwarden.home, linkwarden.local {
	tls internal
	reverse_proxy linkwarden:3000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://linkwarden.example.com {
	reverse_proxy linkwarden:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

linkwarden.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy linkwarden:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
