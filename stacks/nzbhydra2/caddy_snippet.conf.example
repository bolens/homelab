# NZBHydra 2 — split-horizon + public TLS: nzbhydra2.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

nzbhydra2.home, nzbhydra2.local {
	tls internal
	reverse_proxy nzbhydra2:5076 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://nzbhydra2.example.com {
	reverse_proxy nzbhydra2:5076 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

nzbhydra2.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy nzbhydra2:5076 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
