# Prometheus scrape config (homelab). Reload: curl -X POST http://prometheus:9090/-/reload
global:
  # Performance-tuned defaults: keep responsive alerts while reducing TSDB churn.
  scrape_interval: 30s
  evaluation_interval: 30s
  scrape_timeout: 10s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

# Alert rules (copy alerts.yml.example to ~/.config/prometheus/rules/alerts.yml).
rule_files:
  - /etc/prometheus/rules/alerts.yml

scrape_configs:
  - job_name: prometheus
    scrape_interval: 15s
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: cadvisor
    scrape_interval: 30s
    static_configs:
      - targets: ["cadvisor:8080"]

  # CrowdSec LAPI metrics (same port as health; see stacks/crowdsec/docker-compose.yml).
  - job_name: crowdsec
    scrape_interval: 30s
    static_configs:
      - targets: ["crowdsec:6060"]
    metrics_path: /metrics

  - job_name: node
    scrape_interval: 30s
    static_configs:
      - targets: ["node-exporter:9100"]

  # Watchtower (stacks/watchtower on monitor): Bearer matches WATCHTOWER_HTTP_API_TOKEN; secret file in rules dir.
  - job_name: watchtower
    scrape_interval: 30s
    scrape_timeout: 10s
    static_configs:
      - targets: ["watchtower:80"]
    metrics_path: /v1/metrics
    bearer_token_file: /etc/prometheus/rules/watchtower_bearer_token

  - job_name: loki
    scrape_interval: 30s
    static_configs:
      - targets: ["loki:3100"]
    metrics_path: /metrics

  - job_name: promtail
    scrape_interval: 30s
    static_configs:
      - targets: ["promtail:9080"]
    metrics_path: /metrics

  # Tailscale / Headscale exporter (optional): exposes Headscale/Tailscale metrics for the Headscale Overview Grafana dashboard.
  # Deploy stacks/tailscale-exporter first, then enable this job.
  - job_name: tailscale-exporter
    static_configs:
      - targets: ["tailscale-exporter:9250"]
    metrics_path: /metrics

  # Headscale metrics (set metrics_listen_addr: 0.0.0.0:9090 in Headscale config)
  - job_name: headscale
    static_configs:
      - targets: ["headscale:9090"]
    metrics_path: /metrics

  # Optional: enable API in Vector config (e.g. address = "0.0.0.0:9598") and expose 9598 on monitor network
  # - job_name: vector
  #   static_configs:
  #     - targets: ["vector:9598"]
  #   metrics_path: /metrics

  # Optional: Grafana Alloy (stacks/grafana-alloy) — service hostname is `alloy` on the monitor network.
  - job_name: alloy
    scrape_interval: 30s
    static_configs:
      - targets: ["alloy:12345"]
    metrics_path: /metrics
    metric_relabel_configs:
      # Guardrail: drop high-cardinality labels from Alloy self-metrics before storage.
      - regex: 'container_id|id|pid|uuid|guid|trace_id|span_id|session_id|request_id|instance_id|filename|path|url|pod|namespace'
        action: labeldrop

  # Optional: InfluxDB OSS — confirm your version exposes Prometheus metrics on /metrics before enabling.
  - job_name: influxdb
    scrape_interval: 30s
    static_configs:
      - targets: ["influxdb:8086"]
    metrics_path: /metrics

  - job_name: gitea
    scrape_interval: 30s
    static_configs:
      - targets: ["gitea:3000"]
    metrics_path: /metrics
    authorization:
      credentials_file: /etc/prometheus/rules/gitea_metrics_token

  # Alerting set: stable public endpoints only (kept intentionally small).
  - job_name: blackbox_public
    metrics_path: /probe
    scrape_interval: 1m
    scrape_timeout: 15s
    sample_limit: 50
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - https://alertmanager.example.com
          - https://authentik.example.com
          - https://booking.example.com
          - https://crowdsec.example.com
          - https://gitea.example.com
          - https://grafana.example.com
          - https://keycloak.example.com
          - https://paperless.example.com
          - https://portainer.example.com
          - https://prometheus.example.com
          - https://vault.example.com

    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
        regex: (.+)
        replacement: ${1}
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
      - source_labels: [__param_target]
        target_label: target
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'probe_http_duration_seconds|probe_dns_lookup_time_seconds|probe_http_content_length|probe_http_uncompressed_body_length|probe_ip_protocol|probe_ip_addr_hash'
        action: drop

  # Alerting set for explicit health paths.
  - job_name: blackbox_http_paths_public
    metrics_path: /probe
    scrape_interval: 1m
    scrape_timeout: 15s
    sample_limit: 50
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - http://immich-machine-learning:3003/ping
          - https://alertmanager.example.com/-/healthy
          - https://authentik.example.com/
          - https://crowdsec.example.com/health
          - https://gitea.example.com/api/healthz
          - https://immich.example.com/api/server/ping
          - https://portainer.example.com/api/status
          - https://prometheus.example.com/-/healthy
          - https://vault.example.com/alive

    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
        regex: (.+)
        replacement: ${1}
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
      - source_labels: [__param_target]
        target_label: target
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'probe_http_duration_seconds|probe_dns_lookup_time_seconds|probe_http_content_length|probe_http_uncompressed_body_length|probe_ip_protocol|probe_ip_addr_hash'
        action: drop

  # Non-alerting inventory set (large/noisy list: auth redirects, DNS gaps, etc.).
  - job_name: blackbox_nonalert
    metrics_path: /probe
    scrape_interval: 15m
    scrape_timeout: 20s
