# Naisho (Rails) — split-horizon + public TLS: naisho.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

naisho.home, naisho.local {
	tls internal
	reverse_proxy naisho:3000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://naisho.example.com {
	reverse_proxy naisho:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

naisho.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy naisho:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
