# HTTPS front for Ollama; the API is private to the shared ingress-admin network.
ollama.home, ollama.local {
	tls internal
	reverse_proxy ollama:11434 {
		transport http {
			versions 1.1
		}
	}
}

http://ollama.example.com {
	reverse_proxy ollama:11434 {
		transport http {
			versions 1.1
		}
	}
}

ollama.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy ollama:11434 {
		transport http {
			versions 1.1
		}
	}
}
