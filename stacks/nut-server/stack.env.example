# Copy to stack.env and set values. Do not commit stack.env.
#
# TZ/locale: use ../../shared.env (see documents/SHARED-RESOURCES.md)

# Absolute path on the host containing NUT config files.
# Required files: ups.conf, upsd.conf, upsd.users, upsmon.conf
NUT_CONFIG_DIR=/home/youruser/.config/nut-server
