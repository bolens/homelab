# CrowdSec LAPI (local UI / API) — split-horizon + public TLS: crowdsec.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).
# Strongly restrict exposure (Cloudflare Access, firewall, or LAN-only in production).

crowdsec.home, crowdsec.local {
	tls internal
	reverse_proxy crowdsec:8080 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://crowdsec.example.com {
	reverse_proxy crowdsec:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

crowdsec.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy crowdsec:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
