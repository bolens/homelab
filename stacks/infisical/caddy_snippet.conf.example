# Infisical — split-horizon + public TLS: infisical.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

infisical.home, infisical.local {
	tls internal
	reverse_proxy infisical:8080 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://infisical.example.com {
	reverse_proxy infisical:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

infisical.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy infisical:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
