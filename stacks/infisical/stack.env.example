# Infisical – copy to stack.env and set your values.
# Full reference: https://github.com/Infisical/infisical/blob/main/.env.example
# See README "Generating keys and secrets" for: openssl rand -hex 16, openssl rand -base64 32, openssl rand -base64 24

# Required: generate your own (never use these samples in production)
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=replace-with-generated-encryption-key
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-generated-auth-secret

# Postgres (used by DB_CONNECTION_URI)
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=replace-with-generated-password
POSTGRES_USER=infisical
POSTGRES_DB=infisical
DB_CONNECTION_URI=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://redis:6379

# Required when behind Caddy: full URL users use to reach the app (no trailing slash)
# Local: https://infisical.home  Public: https://secrets.yourdomain.com
SITE_URL=https://infisical.home

# Optional: SMTP for invites and notifications
# SMTP_HOST=
# SMTP_PORT=
# SMTP_FROM_ADDRESS=
# SMTP_FROM_NAME=
# SMTP_USERNAME=
# SMTP_PASSWORD=

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
