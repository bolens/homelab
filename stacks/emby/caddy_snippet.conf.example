# Emby — split-horizon + public TLS: emby.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

emby.home, emby.local {
	tls internal
	reverse_proxy emby:8096 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://emby.example.com {
	reverse_proxy emby:8096 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

emby.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy emby:8096 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
