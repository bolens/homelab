# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000


# Media library bind mounts (host → /data/... in container)
EMBY_TV_PATH=/path/to/media/tv
EMBY_MOVIES_PATH=/path/to/media/movies
EMBY_MUSIC_PATH=/path/to/media/music
EMBY_AUDIOBOOKS_PATH=/path/to/media/audiobooks
# Use the scanner-safe Calibre export, not Calibre's live database tree.
EMBY_BOOKS_PATH=/path/to/media/kavita-books
# Optional: EMBY_PHOTOS_PATH=/path/to/media/photos
