# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000


# Media library bind mounts (host → /data/... in container)
EMBY_TV_PATH=/mnt/unraid/media/tv
EMBY_MOVIES_PATH=/mnt/unraid/media/movies
EMBY_MUSIC_PATH=/mnt/unraid/media/music
# Optional: EMBY_AUDIOBOOKS_PATH=/mnt/unraid/media/audiobooks
# Optional: EMBY_BOOKS_PATH=/mnt/unraid/media/books
# Optional: EMBY_PHOTOS_PATH=/mnt/unraid/media/photos
