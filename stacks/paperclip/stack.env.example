# TZ and locale belong in ../../shared.env. See documents/SHARED-RESOURCES.md.
PAPERCLIP_PUBLIC_URL=https://paperclip.example.com
# Generate once with openssl rand -hex 32. Preserve across restarts and restores.
BETTER_AUTH_SECRET=replace-me-with-generated-secret
# Independent secret for signed tool action approvals, generated with openssl rand -hex 32.
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=replace-me-with-independent-signing-secret
POSTGRES_PASSWORD=replace-me-with-generated-hex-password
# Leave signup enabled for initial account creation, then set true and recreate.
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false
# Optional provider credentials can instead be configured through the app.
# OPENAI_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# GEMINI_API_KEY=replace-me

# Optional agent build/browser and developer tooling is configured in web-toolchain.json.
# It uses the existing app volume; no additional environment secret is required.

# Optional docker-compose.subnet.yml only. Verify no Docker/host/VPN overlap.
# PAPERCLIP_SUBNET=10.203.0.0/28

# Optional docker-compose.codex-sandbox.yml uses codex-seccomp.json; no extra variables.
