# Slink — split-horizon + public TLS: img.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

slink.home, slink.local {
	tls internal
	reverse_proxy slink:3000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://img.example.com {
	reverse_proxy slink:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

img.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy slink:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
