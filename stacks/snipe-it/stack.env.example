# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Snipe-IT application settings (see official docs for full list)
APP_URL=https://snipe-it.yourdomain.com
# Generate with: docker run --rm snipe/snipe-it php artisan key:generate --show
APP_KEY=REPLACE_WITH_GENERATED_APP_KEY
APP_TIMEZONE=America/Denver
APP_LOCALE=en
APP_ENV=production

# Database settings (app side — must match snipeit-db service vars below)
DB_CONNECTION=mysql
DB_HOST=snipe-it-db
DB_DATABASE=snipeit
DB_USERNAME=snipeit
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Database service vars (snipeit-db container — must match DB_* above)
MYSQL_DATABASE=snipeit
MYSQL_USER=snipeit
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD

# Mail settings (use shared postfix SMTP relay – stacks/postfix)
MAIL_DRIVER=smtp
MAIL_HOST=smtp-relay
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDR=snipeit@yourdomain.com
MAIL_FROM_NAME="Snipe-IT"
