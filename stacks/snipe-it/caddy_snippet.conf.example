# Snipe-IT — split-horizon + public TLS: snipe-it.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

snipe-it.home, snipe-it.local {
	tls internal
	reverse_proxy snipeit:80 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://snipe-it.example.com {
	reverse_proxy snipeit:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

snipe-it.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy snipeit:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
