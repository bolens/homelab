# Mealie — split-horizon + public TLS: mealie.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

mealie.home, mealie.local {
	tls internal
	reverse_proxy mealie:9000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://mealie.example.com {
	reverse_proxy mealie:9000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

mealie.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy mealie:9000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
