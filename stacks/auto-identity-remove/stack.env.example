# auto-identity-remove Configuration
# Copy to stack.env (or run ./prepare-stack.sh) and customize as needed.

# Host port for the API / Swagger UI (default: 5000)
AIR_PORT=5000

# Ollama model to use for PII detection (must be pulled in your Ollama instance)
# Default: llama3.2  — other good options: llama3.1, mistral, gemma3
OLLAMA_MODEL=llama3.2

# Ollama endpoint — points to the shared ollama stack on the ingress-admin network by default.
# To use the Ollama baked into this image, set: http://localhost:11434
# and remove the extra_hosts entry in docker-compose.yml.
OLLAMA_HOST=http://ollama:11434
