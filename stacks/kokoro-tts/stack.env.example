# Pin the image tag for reproducible deploys (see GHCR tags).
# KOKORO_IMAGE_TAG=latest
#
# API logging: DEBUG, INFO, WARNING, ERROR
API_LOG_LEVEL=INFO

# TZ/locale: use ../../shared.env (see documents/SHARED-RESOURCES.md)
