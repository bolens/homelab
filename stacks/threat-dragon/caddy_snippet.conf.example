# OWASP Threat Dragon — split-horizon + public TLS: threat-dragon.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

threat-dragon.home, threat-dragon.local {
	tls internal
	reverse_proxy threat-dragon:80 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://threat-dragon.example.com {
	reverse_proxy threat-dragon:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

threat-dragon.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy threat-dragon:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
