# Required when behind reverse proxy (Caddy). Use your actual URL.
PAPERLESS_URL=https://paperless.yourdomain.com

# Long random string when exposing publicly. Generate with: openssl rand -hex 32
PAPERLESS_SECRET_KEY=change-me-use-openssl-rand-hex-32

# Postgres database credentials (optional, defaults shown)
POSTGRES_DB=paperless
POSTGRES_USER=paperless
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-use-openssl-rand-base64-24

# Optional: see https://docs.paperless-ngx.com/configuration/
# USERMAP_UID=1000
# USERMAP_GID=1000
# PAPERLESS_OCR_LANGUAGE=eng

# Optional per-user originals. Verify the filesystem and create the directory
# before enabling docker-compose.storage.yml. This path is on the Docker host.
# PAPERLESS_ORIGINALS_PATH=/srv/documents/paperless
# PAPERLESS_FILENAME_FORMAT={{ owner_username }}/{{ created_year }}/{{ doc_pk }}-{{ title }}
# Enable when routing consume/<username>/ imports with ownership workflows.
# PAPERLESS_CONSUMER_RECURSIVE=true

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
