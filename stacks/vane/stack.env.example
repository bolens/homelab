# Vane (formerly Perplexica) - privacy-focused AI answering engine
# Copy to stack.env and customize. Do NOT commit stack.env.
# Build the pinned compatibility image with docker compose up -d --build.
#
# Configure provider secrets only after owner-only Access protects the full site.
#
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# SearxNG Configuration
# Leave empty to use bundled SearxNG (recommended)
# If you have an external SearxNG instance, set its URL here
# Example: http://searxng:8080 or http://host.docker.internal:8080
SEARXNG_API_URL=

# Ollama Configuration
# Set to http://ollama:11434 if Ollama is on the shared ai-backend network
# Set to http://host.docker.internal:11434 if Ollama runs on the same Docker host
OLLAMA_BASE_URL=

# Existing Perplexica upgrades: set this to the original Docker data volume name.
# New installations can leave it empty.
VANE_DATA_VOLUME=
# Set true when VANE_DATA_VOLUME names an existing Perplexica volume.
VANE_DATA_EXTERNAL=false

# Optional LiteLLM connection through the OpenAI-compatible provider.
# Set OPENAI_BASE_URL=http://litellm:4000/v1 and use a dedicated virtual key.
# Add the exact gateway model alias in Vane settings; custom URLs do not discover models.
OPENAI_BASE_URL=
OPENAI_API_KEY=
