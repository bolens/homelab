# YOURLS — split-horizon + public TLS: urls.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).
# LAN uses urls.home / urls.local to match YOURLS_SITE patterns.

urls.home, urls.local {
	tls internal
	reverse_proxy yourls:8080 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://urls.example.com {
	reverse_proxy yourls:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

urls.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy yourls:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
