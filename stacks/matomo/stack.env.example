# Matomo — self-hosted web analytics.
# Copy to stack.env and set real values. Do NOT commit real credentials.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
#
# Docs: https://matomo.org/

# Database credentials (used by Matomo and its MariaDB container)
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
# Generate with: openssl rand -hex 32
MATOMO_DB_PASSWORD=changeme

# Optional: separate MariaDB root password for direct DB access
# Generate with: openssl rand -hex 32
MATOMO_DB_ROOT_PASSWORD=changeme

# Absolute path to matomo config.ini.php on the host.
# Required when HOME is unset (e.g. Portainer). Example:
MATOMO_CONFIG_PATH=/home/youruser/.config/matomo/config.ini.php

# Base URL for scheduled archiving cron job (must match your Caddy hostname)
MATOMO_BASE_URL=https://matomo.example.com
MATOMO_ARCHIVE_INTERVAL_SECONDS=3600
