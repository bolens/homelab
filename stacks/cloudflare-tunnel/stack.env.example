# Cloudflare Tunnel Token
# Get this from: Cloudflare Dashboard → Zero Trust → Networks → Tunnels → Create Tunnel
# Or: https://one.dash.cloudflare.com/
TUNNEL_TOKEN=your-tunnel-token-here

# Edge transport: auto starts with QUIC and can fall back to HTTP/2.
# Use http2 for public HTTP routes when intermittent UDP/7844 loss stalls QUIC.
# This is passed directly through env_file; see README for verification/tradeoffs.
TUNNEL_TRANSPORT_PROTOCOL=auto

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
