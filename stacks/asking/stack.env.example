# Asking (Strawpoll-style polls) — copy to stack.env and set real values.
# Do NOT commit real secrets.
# Upstream: https://github.com/jdleo/asking
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Optional: override container images (e.g. to use a private Harbor registry)
# ASKING_FRONTEND_IMAGE=harbor.example.com/homelab/asking-frontend:latest
# ASKING_API_IMAGE=harbor.example.com/homelab/asking-api:latest

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL credentials (used by asking-db and asking-api)
POSTGRES_USER=asking
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=changeme
POSTGRES_DB=asking

# Public URL where users access Asking (must match your Caddy hostname)
ASKING_PUBLIC_URL=https://poll.example.com

# Sequelize dialect
DIALECT=postgres

# Database URI for Sequelize (substitute the same password used above)
DATABASE_URI=postgresql://asking:changeme@asking-db:5432/asking
