# Enclosed – E2E-encrypted notes (zero-knowledge server)
# Copy to stack.env and customize. Do NOT commit real secrets.
#
# Docs:
# - Self-host: https://docs.enclosed.cc/self-hosting/docker
# - Configuration: https://docs.enclosed.cc/self-hosting/configuration
# - Image:       https://hub.docker.com/r/corentinth/enclosed

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# --- Reverse proxy (Caddy) – recommended when exposed on a public hostname ---
# Set both to your real public URL (scheme + host, no trailing path unless you use a subpath).
# Example: https://enclosed.example.com
# PUBLIC_BASE_API_URL=https://enclosed.example.com
# SERVER_CORS_ORIGINS=https://enclosed.example.com

# --- Optional: require login to create notes (see upstream user generator) ---
# PUBLIC_IS_AUTHENTICATION_REQUIRED=true
# AUTHENTICATION_JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
# AUTHENTICATION_USERS=email:bcryptHash,...

# --- Optional knobs (defaults are usually fine) ---
# PORT=8787
# NOTES_MAX_ENCRYPTED_PAYLOAD_LENGTH=52428800
# TASK_DELETE_EXPIRED_NOTES_CRON=0 * * * *
