# code-server (LinuxServer image). Copy to stack.env and set secrets. Run ./prepare-stack.sh then docker compose up -d.
# Docs: https://docs.linuxserver.io/images/docker-code-server/

# Match the UID/GID that should own files in the /config volume (see `id` on the host).
PUID=1000
PGID=1000

# Web UI password (plain). Optional: leave empty for no password (only safe behind another auth layer, e.g. Cloudflare Access).
# Generate: openssl rand -base64 32
PASSWORD=

# Optional: sudo in the integrated terminal (plain password).
SUDO_PASSWORD=

# When behind a reverse proxy with TLS (e.g. Caddy), set to the public hostname (no https://).
PROXY_DOMAIN=code.example.com

# Optional: default folder opened in the editor (inside the container).
# DEFAULT_WORKSPACE=/config/workspace

# TZ/locale: prefer ../../shared.env (see documents/SHARED-RESOURCES.md).
