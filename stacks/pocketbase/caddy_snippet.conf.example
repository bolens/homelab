# PocketBase — split-horizon + public TLS: pocketbase.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

pocketbase.home, pocketbase.local {
	tls internal
	reverse_proxy pocketbase:8080 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://pocketbase.example.com {
	reverse_proxy pocketbase:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

pocketbase.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy pocketbase:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
