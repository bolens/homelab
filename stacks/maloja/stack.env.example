# Maloja — self-hosted scrobble server.
# Copy to stack.env and adjust as needed. Do NOT commit real secrets.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
#
# Docs: https://github.com/krateng/maloja

# ---------------------------------------------------------------------------
# Required — admin password set on first start (used for admin UI and API keys)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 24
MALOJA_FORCE_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Optional — host file ownership (match your host user if using bind mounts)
# ---------------------------------------------------------------------------
# Run: id -u && id -g
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Optional — third-party API keys for metadata and artwork (free tiers available)
# Set here or in the Maloja admin UI after first start.
# ---------------------------------------------------------------------------
# Spotify: https://developer.spotify.com/dashboard
MALOJA_SPOTIFY_API_ID=
MALOJA_SPOTIFY_API_SECRET=

# Last.fm: https://www.last.fm/api/account/create
MALOJA_LASTFM_API_KEY=
MALOJA_LASTFM_API_SECRET=
