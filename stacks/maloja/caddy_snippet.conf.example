# Maloja — split-horizon + public TLS: maloja.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

maloja.home, maloja.local {
	tls internal
	reverse_proxy maloja:42010 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://maloja.example.com {
	reverse_proxy maloja:42010 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

maloja.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy maloja:42010 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
