modules:
  http_2xx:
    prober: http
    timeout: 15s
    http:
      valid_status_codes: []
      follow_redirects: true
      preferred_ip_protocol: "ip4"

  tcp_connect:
    prober: tcp
    timeout: 10s
    tcp:
      preferred_ip_protocol: "ip4"

  # ICMP (gateway / WAN / LAN host). Requires blackbox container CAP_NET_RAW — see stacks/blackbox-exporter/docker-compose.yml.
  icmp:
    prober: icmp
    timeout: 5s
    icmp:
      preferred_ip_protocol: "ip4"

  # DNS resolution check (UDP). Replace this documentation-safe example with
  # a stable public or internal record for your deployment.
  dns_udp:
    prober: dns
    timeout: 5s
    dns:
      transport_protocol: udp
      preferred_ip_protocol: "ip4"
      query_name: "example.com"
      query_type: "A"

  # Blackbox exporter v0.28+ removed http.path. Put the full URL (including path) in Prometheus
  # targets and use module http_2xx — see stacks/prometheus/prometheus.yml.example → blackbox_http_paths.

  # HTTPS with TLS verify disabled (e.g. step-ca container). Target must include path, e.g. https://ca:9000/health
  https_stepca_health:
    prober: http
    timeout: 15s
    http:
      valid_status_codes: []
      follow_redirects: true
      preferred_ip_protocol: "ip4"
      tls_config:
        insecure_skip_verify: true
