# ConvertX — split-horizon + public TLS: convertx.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

convertx.home, convertx.local {
	tls internal
	reverse_proxy convertx:3000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://convertx.example.com {
	reverse_proxy convertx:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

convertx.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy convertx:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
