# Loki – log aggregation. Copy to stack.env and adjust as needed.
#
# Absolute path is required when deploying from Portainer.
LOKI_CONFIG_PATH=/home/youruser/.config/loki/loki-config.yml
LOKI_PRIMARY_RETENTION=720h
LOKI_SAMPLED_RETENTION=168h
LOKI_INGESTION_MAX_AGE=168h
#
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
