auth_enabled: false

analytics:
  reporting_enabled: false

server:
  http_listen_port: 3100

ingester:
  lifecycler:
    address: 127.0.0.1
    ring:
      kvstore:
        store: inmemory
      replication_factor: 1
    final_sleep: 0s
  chunk_idle_period: 3m
  max_chunk_age: 1h
  chunk_target_size: 1536000
  chunk_retain_period: 30s
  wal:
    enabled: true
    dir: /loki/wal

schema_config:
  configs:
    - from: 2020-10-24
      store: boltdb-shipper
      object_store: filesystem
      schema: v11
      index:
        prefix: index_
        period: 24h
    # Keep Loki 2.9.8 running through this UTC boundary before upgrading to
    # Loki 3.x. New data then uses the required TSDB/v13 schema while old
    # boltdb-shipper data remains queryable.
    - from: 2026-08-05
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  retention_delete_delay: 2h

storage_config:
  boltdb_shipper:
    active_index_directory: /loki/index
    cache_location: /loki/index_cache
    shared_store: filesystem
  tsdb_shipper:
    active_index_directory: /loki/tsdb-index
    cache_location: /loki/tsdb-cache
    shared_store: filesystem
  filesystem:
    directory: /loki/chunks

limits_config:
  retention_period: ${LOKI_PRIMARY_RETENTION}  # default: 30 days
  retention_stream:
    - selector: '{stream_class="sampled"}'
      priority: 2
      period: ${LOKI_SAMPLED_RETENTION}  # default: 7 days
    - selector: '{stream_class="primary"}'
      priority: 1
      period: ${LOKI_PRIMARY_RETENTION}  # default: 30 days
  reject_old_samples: true
  reject_old_samples_max_age: ${LOKI_INGESTION_MAX_AGE}
  ingestion_rate_mb: 24
  ingestion_burst_size_mb: 48
  per_stream_rate_limit: 10MB
  per_stream_rate_limit_burst: 20MB
  max_label_names_per_series: 20
  max_global_streams_per_user: 20000
  split_queries_by_interval: 1h
  max_query_parallelism: 4
  max_entries_limit_per_query: 3000
  query_timeout: 90s
  max_query_series: 3000

query_range:
  parallelise_shardable_queries: true

frontend:
  log_queries_longer_than: 5s
  compress_responses: true

frontend_worker:
  frontend_address: loki:9095

ruler:
  storage:
    type: local
    local:
      directory: /loki/rules
  rule_path: /loki/rules-temp
  alertmanager_url: http://alertmanager:9093
  ring:
    kvstore:
      store: inmemory
  enable_api: true
