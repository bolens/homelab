# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
POSTIZ_URL=https://postiz.yourdomain.com
# Generate each with: openssl rand -hex 32
POSTIZ_JWT_SECRET=changeme
POSTIZ_DB_PASSWORD=changeme
TEMPORAL_DB_PASSWORD=changeme
# Set true after creating the initial account.
POSTIZ_DISABLE_REGISTRATION=false
