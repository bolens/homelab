# SimpleLogin — split-horizon + public TLS: simplelogin.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

simplelogin.home, simplelogin.local {
	tls internal
	reverse_proxy simplelogin:7777 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://simplelogin.example.com {
	reverse_proxy simplelogin:7777 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

simplelogin.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy simplelogin:7777 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
