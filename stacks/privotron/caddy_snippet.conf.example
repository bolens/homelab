# Privotron — split-horizon + public TLS: privotron.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

privotron.home, privotron.local {
	tls internal
	reverse_proxy privotron:80 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://privotron.example.com {
	reverse_proxy privotron:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

privotron.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy privotron:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
