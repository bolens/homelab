# HandBrake (LinuxServer web UI) — split-horizon + public TLS: handbrake.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

handbrake.home, handbrake.local {
	tls internal
	reverse_proxy handbrake:5800 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://handbrake.example.com {
	reverse_proxy handbrake:5800 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

handbrake.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy handbrake:5800 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
