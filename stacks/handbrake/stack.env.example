# HandBrake — copy to stack.env and adjust as needed.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# File ownership — match your host user (run: id -u && id -g)
USER_ID=1000
GROUP_ID=1000
UMASK=002

# Existing bind-mount paths. Preparation creates only the local config directory.
HANDBRAKE_CONFIG_PATH=${HOME}/.config/handbrake
HANDBRAKE_STORAGE_PATH=/path/to/media
HANDBRAKE_WATCH_PATH=/path/to/media/downloads/handbrake/watch
HANDBRAKE_OUTPUT_PATH=/path/to/media/downloads/handbrake/output
