# HandBrake — copy to stack.env and adjust as needed.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# File ownership — match your host user (run: id -u && id -g)
USER_ID=1000
GROUP_ID=1000
UMASK=002

# Override HandBrake bind-mount paths if your media layout differs from docker-compose defaults.
# HANDBRAKE_CONFIG_PATH=/path/to/your/config
# HANDBRAKE_WATCH_PATH=/path/to/your/watch
# HANDBRAKE_OUTPUT_PATH=/path/to/your/output
