# camofox-browser – copy to stack.env and configure.
# Docs: https://github.com/jo-inc/camofox-browser#environment-variables

# =========================================================
# Core
# =========================================================

# Server port (must match compose ports mapping)
CAMOFOX_PORT=9377

# =========================================================
# Security / Access Control
# =========================================================
# Access key — gates all routes (except /health). Set this when exposing beyond loopback.
# Clients send: Authorization: Bearer <key>
# CAMOFOX_ACCESS_KEY=changeme

# API key — required to use the cookie import endpoint
# CAMOFOX_API_KEY=changeme

# Admin key — required for POST /stop
# CAMOFOX_ADMIN_KEY=changeme

# =========================================================
# Session / Resource limits
# =========================================================
# MAX_SESSIONS=50
# MAX_TABS_PER_SESSION=10
# SESSION_TIMEOUT_MS=1800000
# BROWSER_IDLE_TIMEOUT_MS=300000
# HANDLER_TIMEOUT_MS=30000
# MAX_CONCURRENT_PER_USER=3

# Node.js heap limit in MB
# MAX_OLD_SPACE_SIZE=128

# =========================================================
# Proxy (optional)
# =========================================================
# Simple single-endpoint proxy:
# PROXY_HOST=proxy.example.com
# PROXY_PORT=8080
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Backconnect / rotating proxy (e.g. Decodo):
# PROXY_STRATEGY=backconnect
# PROXY_PROVIDER=decodo
# PROXY_BACKCONNECT_HOST=
# PROXY_BACKCONNECT_PORT=7000
# PROXY_COUNTRY=US
# PROXY_STATE=

# =========================================================
# Telemetry (anonymous crash/hang reports)
# =========================================================
# Disable if you don't want any outbound telemetry:
# CAMOFOX_CRASH_REPORT_ENABLED=false

# =========================================================
# Tab lifecycle
# =========================================================
# TAB_INACTIVITY_MS=300000
