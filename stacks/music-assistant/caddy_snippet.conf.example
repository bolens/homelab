# Review authentication before enabling a public hostname. No host ports are published, except Music Assistant host networking.
music-assistant.home.arpa, music-assistant.local {
    tls internal
    reverse_proxy host.docker.internal:8095 {
        transport http {
            versions 1.1
        }
    }
}

http://music-assistant.example.com {
    reverse_proxy host.docker.internal:8095 {
        header_up X-Forwarded-Proto https
        transport http {
            versions 1.1
        }
    }
}

music-assistant.example.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    reverse_proxy host.docker.internal:8095 {
        transport http {
            versions 1.1
        }
    }
}
