# docker-gc (cleanup UI/API) — split-horizon + public TLS: docker-gc.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).
# Public exposure is high-impact; restrict with Cloudflare Access / IP allowlists if enabled.

docker-gc.home, docker-gc.local {
	tls internal
	reverse_proxy docker-gc:80 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://docker-gc.example.com {
	reverse_proxy docker-gc:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

docker-gc.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy docker-gc:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
