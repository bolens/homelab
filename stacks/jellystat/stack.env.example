# Jellystat – Jellyfin statistics (CyferShepard/Jellystat)
# Copy to stack.env and customize. Do NOT commit real secrets.
#
# Upstream env reference: https://github.com/CyferShepard/Jellystat#environmental-variables
# Docker image: https://hub.docker.com/r/cyfershepard/jellystat

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# PostgreSQL (same user/password on jellystat-db and app)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD

# Database name (must match POSTGRES_DB on the Postgres container)
POSTGRES_DB=jfstat

# JWT signing secret for Jellystat sessions (e.g. openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_GENERATED_JWT_SECRET

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Master override login if you lose the admin password (both must be set to take effect)
# JS_USER=
# JS_PASSWORD=

# Base URL path if served under a subpath (default /)
# JS_BASE_URL=/

# Emby instead of Jellyfin
# IS_EMBY_API=false

# Jellyfin websocket session data (Jellyfin only)
# JF_USE_WEBSOCKETS=true

# MaxMind GeoLite for IP geolocation (optional)
# JS_GEOLITE_ACCOUNT_ID=
# JS_GEOLITE_LICENSE_KEY=

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md). Jellystat requires TZ at runtime—ensure shared.env defines TZ or set TZ= here.
