# Apache Guacamole — split-horizon + public TLS: guacamole.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

guacamole.home, guacamole.local {
	tls internal
	reverse_proxy guacamole:8080 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://guac.example.com {
	reverse_proxy guacamole:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

guac.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy guacamole:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
