# Komga – copy to stack.env. Optional: set TZ and JAVA_TOOL_OPTIONS.
# Docs: https://komga.org/docs/installation/configuration

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Read-only libraries managed by Mylar3 or another organizer.
KOMGA_COMICS_PATH=/path/to/media/comics
KOMGA_MANGA_PATH=/path/to/media/manga

# Optional: increase JVM heap for large libraries (e.g. 4GB)
# JAVA_TOOL_OPTIONS=-Xmx4g

# Optional docker-compose.normalizer.yml override (see README).
# Match the media owner. The Komga config volume must be writable by this UID.
# PUID=1000
# PGID=1000
# NORMALIZER_STATE_PATH=./normalizer-state
# NORMALIZER_CONFIG_PATH=./normalizer.json
# Optional Mylar directory containing config.ini and mylar.db, mounted read-only.
# MYLAR_CONFIG_PATH=/path/to/mylar/config

# Optional docker-compose.maintenance.yml, after the normalizer override.
# Existing completed-comics directory. The worker requires write access here.
# MYLAR_COMPLETED_PATH=/path/to/media/downloads/usenet/completed/comics
# Narrow writable cache mount; the remaining Mylar config stays read-only.
# MYLAR_DDL_CACHE_PATH=/path/to/mylar/config/cache

# Guided import receipts share NORMALIZER_STATE_PATH; update Mylar before this worker.
# Published image; pin a sha-<commit> tag or digest for reproducible redeployments.
COMIC_NORMALIZER_IMAGE=ghcr.io/bolens/homelab-comic-normalizer:latest
