# Audiobookshelf — split-horizon + public TLS: audiobookshelf.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

audiobookshelf.home, audiobookshelf.local {
	tls internal
	reverse_proxy audiobookshelf:80 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://audiobookshelf.example.com {
	reverse_proxy audiobookshelf:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

audiobookshelf.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy audiobookshelf:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
