# MusicBrainz Picard - copy to stack.env and customize.
# Docs: https://picard-docs.musicbrainz.org/
#
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Optional: run as your host user for bind-mounted file ownership.
PUID=1000
PGID=1000

# Host path for your main music library (Picard writes organized files here).
PICARD_MUSIC_PATH=/path/to/media/music

# Soulseek staging/import path (host → /soulseek-intake in Picard).
PICARD_SOULSEEK_INTAKE_PATH=/path/to/media/downloads/soulseek

# Lidarr staging/import path (host → /lidarr-intake in Picard).
PICARD_LIDARR_INTAKE_PATH=/path/to/media/intake/lidarr
