# MusicBrainz Picard - copy to stack.env and customize.
# Docs: https://picard-docs.musicbrainz.org/
#
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Optional: run as your host user for bind-mounted file ownership.
PUID=1000
PGID=1000

# Host path for your main music library (Picard writes organized files here).
PICARD_MUSIC_PATH=/mnt/media/music

# Optional staging/import source path (e.g. Soulseek completed downloads).
PICARD_IMPORT_PATH=/mnt/media/downloads/soulseek
