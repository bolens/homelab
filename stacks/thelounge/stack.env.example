# TheLounge IRC client — copy to stack.env and adjust as needed.
# See https://thelounge.chat/docs/configuration.html for options
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Set TheLounge to public mode (anyone can connect, no auth — not recommended for production)
# THELOUNGE_PUBLIC=true

# Override the internal listen port (default: 9000)
# THELOUNGE_PORT=9000
