# The Lounge — split-horizon + public TLS: thelounge.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

thelounge.home, thelounge.local {
	tls internal
	reverse_proxy thelounge:9000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://thelounge.example.com {
	reverse_proxy thelounge:9000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

thelounge.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy thelounge:9000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
