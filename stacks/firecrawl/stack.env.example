# Firecrawl – copy to stack.env and configure.
# Docs: https://github.com/firecrawl/firecrawl/blob/main/SELF_HOST.md

# =========================================================
# Core
# =========================================================

# Set to false to allow unauthenticated access (for self-hosted personal use).
# Set to true and configure Supabase below for multi-user / production use.
USE_DB_AUTHENTICATION=false

# Static API key used when USE_DB_AUTHENTICATION=false.
# Can be any non-empty string; clients pass this as Bearer token.
TEST_API_KEY=REPLACE_WITH_FIRECRAWL_API_KEY

# API port (internal; Caddy terminates TLS externally)
PORT=3002

# =========================================================
# Supabase (required if USE_DB_AUTHENTICATION=true)
# =========================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_TOKEN=your_anon_key
# SUPABASE_SERVICE_TOKEN=your_service_role_key

# =========================================================
# AI / LLM (optional – required for llmExtract feature)
# =========================================================
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL_NAME=gpt-4o
# MODEL_EMBEDDING_NAME=text-embedding-3-small

# =========================================================
# Search enrichment (optional)
# =========================================================
# SERPER_API_KEY=
# SEARCHAPI_API_KEY=
# JINA_API_KEY=

# =========================================================
# Proxy (optional – for outbound scraping through a proxy)
# =========================================================
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=
# PROXY_PASSWORD=
# BLOCK_MEDIA=false

# =========================================================
# Playwright / JS rendering
# =========================================================
# Handled internally by the playwright-service container.
# Only set this if you run a separate/external playwright service.
# PLAYWRIGHT_MICROSERVICE_URL=http://firecrawl-playwright:3000

# =========================================================
# Bull queue dashboard
# =========================================================
# BULL_AUTH_KEY=changeme

# =========================================================
# Webhooks
# =========================================================
# SELF_HOSTED_WEBHOOK_SECRET=changeme

# =========================================================
# Worker tuning (optional)
# =========================================================
# NUM_WORKERS_PER_QUEUE=8
# MAX_RAM_USAGE=4096

# =========================================================
# Logging / observability (optional)
# =========================================================
# LOGTAIL_KEY=
# SLACK_WEBHOOK_URL=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com
# LOGGING_LEVEL=info
