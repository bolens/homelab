# AFFiNE
# Copy to stack.env and customize.
#
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Public URL for callbacks and generated links.
AFFINE_SERVER_EXTERNAL_URL=https://affine.example.com

# Dedicated PostgreSQL credentials. Generate a unique password, for example:
# openssl rand -base64 36
DB_USERNAME=affine
DB_PASSWORD=replace-with-a-long-random-password
DB_DATABASE=affine
