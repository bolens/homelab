# clark-browser – copy to stack.env and configure.
# Docs: https://github.com/clark-labs-inc/clark-browser#readme

# =========================================================
# Server
# =========================================================
# CDP port (must match compose ports mapping)
# Configured via clarkserve --port flag in CMD, not an env var.
# To change from 9222, update the CMD in build/Dockerfile.

# Additional approved public CDP origins. No wildcard, path, credentials or trailing slash.
# Loopback HTTP origins on port9222 are always allowed. Explicitly list every Caddy
# hostname/scheme before enabling its route; these match caddy_snippet.conf.example.
CLARK_CDP_ORIGINS=https://clark.home,https://clark.local

# =========================================================
# Fingerprint
# =========================================================
# Platform profile: linux | macos | windows
# Defaults to host platform (linux in container).
# CLARK_FINGERPRINT_PLATFORM=linux

# Network profile: desktop | datacenter | residential | mobile | slow
# CLARK_FINGERPRINT_NETWORK_PROFILE=datacenter

# Windows font directory (required for Windows profiles on Linux hosts)
# CLARK_WINDOWS_FONTS_DIR=

# Font directory override for any custom font pack
# CLARK_FINGERPRINT_FONTS_DIR=

# =========================================================
# WebRTC / WebGPU stealth
# =========================================================
# WebRTC policy: proxy-coherent (suppress local IPs when proxied)
# CLARK_WEBRTC_POLICY=proxy-coherent

# Enable coherent WebGPU fingerprint (off by default — WebGPU disabled)
# CLARK_WEBGPU_POLICY=coherent

# =========================================================
# Launch hygiene
# =========================================================
# strict = fail fast; also refuses deliberate non-loopback CDP adapter exposure.
# off = permissive (good for local experiments)
# CLARK_LAUNCH_HYGIENE=strict

# =========================================================
# Proxy (optional)
# =========================================================
# CLARK_PROXY_SERVER=http://proxy.example.com:8080
# Authenticated proxies are not supported by the direct Chromium launcher.
# Nonempty credential values cause a startup refusal instead of being ignored.
# CLARK_PROXY_USERNAME=
# CLARK_PROXY_PASSWORD=
# Harbor fallback: CLARK_BROWSER_IMAGE=harbor.bolens.dev/homelab/clark-browser:latest
