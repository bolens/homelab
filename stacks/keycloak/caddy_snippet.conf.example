# Keycloak — split-horizon + public TLS: keycloak.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

keycloak.home, keycloak.local {
	tls internal
	reverse_proxy keycloak:8080 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://keycloak.example.com {
	reverse_proxy keycloak:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

keycloak.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy keycloak:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
