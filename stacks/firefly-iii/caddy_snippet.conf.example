# Firefly III — split-horizon + public TLS: firefly-iii.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

firefly-iii.home, firefly-iii.local {
	tls internal
	reverse_proxy firefly-iii:8080 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://firefly.example.com {
	reverse_proxy firefly-iii:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

firefly.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy firefly-iii:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
