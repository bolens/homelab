# AnythingLLM — https://github.com/Mintplex-Labs/anything-llm
# Copy to stack.env (or run ./prepare-stack.sh). Do NOT commit stack.env.
#
# Required for multi-user / production sessions (20+ random chars).
JWT_SECRET=replace-with-openssl-rand-base64-32

# LLM + embeddings via shared Ollama on `monitor`
LLM_PROVIDER=ollama
OLLAMA_BASE_PATH=http://ollama:11434
OLLAMA_MODEL_PREF=gemma4:latest
OLLAMA_MODEL_TOKEN_LIMIT=4096
EMBEDDING_ENGINE=ollama
EMBEDDING_BASE_PATH=http://ollama:11434
EMBEDDING_MODEL_PREF=nomic-embed-text:latest
EMBEDDING_MODEL_MAX_CHUNK_LENGTH=8192
VECTOR_DB=lancedb

# Optional: point built-in Whisper at this stack (same Docker network)
# WHISPER_PROVIDER=local
# AnythingLLM “local” Whisper uses the bundled binary; for OpenAI-compatible HTTP use the UI to add a custom STT URL, e.g. http://whisper-asr:9000

STORAGE_DIR=/app/server/storage

# TZ/locale: use ../../shared.env (see documents/SHARED-RESOURCES.md)
