# Mailpit — split-horizon + public TLS: mailpit.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

mailpit.home, mailpit.local {
	tls internal
	reverse_proxy mailpit:8025 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://mailpit.example.com {
	reverse_proxy mailpit:8025 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

mailpit.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy mailpit:8025 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
