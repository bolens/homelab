# NZBGet — split-horizon + public TLS: nzbget.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

nzbget.home, nzbget.local {
	tls internal
	reverse_proxy nzbget:6789 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://nzbget.example.com {
	reverse_proxy nzbget:6789 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

nzbget.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy nzbget:6789 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
