# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000

# Optional: override umask (e.g. 002 for group-write)
UMASK=002

# Optional: set an initial web UI homelab-user/password
# NZBGET_USER=nzbget
# NZBGET_PASS=REPLACE_WITH_GENERATED_PASSWORD

# Usenet downloads bind mount (host → /downloads; shared with *arr stacks)
NZBGET_DOWNLOADS_PATH=/path/to/media/downloads/usenet
