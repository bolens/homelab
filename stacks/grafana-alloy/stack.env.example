# Grafana Alloy — copy to stack.env and adjust as needed.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
#
# Docs: https://grafana.com/docs/alloy/latest/

# Absolute path to your config.alloy file on the host.
# Required when deploying from Portainer (relative paths won't resolve).
ALLOY_CONFIG_PATH=/home/youruser/.config/grafana-alloy/config.alloy

# Optional: interval for canary heartbeat log lines (seconds)
# CANARY_INTERVAL_SECONDS=60
