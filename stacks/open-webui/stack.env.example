# Open WebUI - self-hosted AI chat platform
# Copy to stack.env and customize. Do NOT commit stack.env.
#
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# Ollama Configuration
# Set to http://ollama:11434 if Ollama is on the same Docker network
# Set to http://host.docker.internal:11434 if Ollama is on host
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI Configuration (optional)
# If you want to use OpenAI API directly, set your API key here
# OPENAI_API_KEY=sk-your-api-key-here
#
# LiteLLM proxy (optional): OpenAI-compatible base URL on the same Docker network
# OPENAI_API_BASE_URL=http://litellm:4000/v1
# OPENAI_API_KEY=<same value as LITELLM_MASTER_KEY in stacks/litellm/stack.env>

# Hugging Face (optional)
# Get a read token at https://huggingface.co/settings/tokens for higher rate limits and faster model/downloads from HF Hub
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Authentication Configuration
# Allow new user signups (true/false)
ENABLE_SIGNUP=true

# Default role for new users (user/admin)
DEFAULT_USER_ROLE=user

# Security Keys (optional, auto-generated if not set)
# Generate with: openssl rand -base64 32
# WEBUI_SECRET_KEY=***
# WEBUI_JWT_SECRET_KEY=***

# Speech-to-text (STT): use stacks/whisper-asr on the monitor network.
# whisper-asr exposes an OpenAI-compatible /v1/audio/transcriptions endpoint.
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=http://whisper-asr:9000/v1
AUDIO_STT_OPENAI_API_KEY=not-needed
AUDIO_STT_MODEL=whisper-1

# Text-to-speech (TTS): use stacks/kokoro-tts on the monitor network.
# kokoro-tts exposes an OpenAI-compatible /v1/audio/speech endpoint.
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=http://kokoro-tts:8880/v1
AUDIO_TTS_OPENAI_API_KEY=not-needed
AUDIO_TTS_VOICE=af_heart
