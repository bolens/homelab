# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000

# Soulseek login used by slskd to connect to the Soulseek network.
SLSKD_SLSK_USERNAME=REPLACE_WITH_YOUR_SOULSEEK_USERNAME
SLSKD_SLSK_PASSWORD=REPLACE_WITH_YOUR_SOULSEEK_PASSWORD

# slskd web UI/API login credentials (separate from Soulseek network login).
SLSKD_USERNAME=REPLACE_WITH_YOUR_SLSKD_WEB_USERNAME
SLSKD_PASSWORD=REPLACE_WITH_YOUR_SLSKD_WEB_PASSWORD
# Primary API key for automation clients (e.g. Explo).
SLSKD_API_KEY=REPLACE_WITH_SLSKD_API_KEY

# Soulseek peer listen port (must match firewall/router forward if remote peers should reach you).
SLSKD_SLSK_LISTEN_PORT=50300

# Host path for completed downloads bind-mounted to /downloads in the container.
SLSKD_DOWNLOADS_PATH=/mnt/unraid/media/downloads/soulseek/
# Host path for your music library bind-mounted to /music and published as a Soulseek share.
SLSKD_SHARED_MUSIC_PATH=/mnt/unraid/media/music/
# Semicolon-delimited list of container paths to share on Soulseek.
SLSKD_SHARED_DIR=/music
# Force a share rescan on startup so newly added share paths are indexed.
SLSKD_FORCE_SHARE_SCAN=false
# Force slskd to write completed downloads and temporary partials to mounted paths.
SLSKD_DOWNLOADS_DIR=/downloads
SLSKD_INCOMPLETE_DIR=/incomplete

# Remote/API features (needed for automation clients like Explo).
# headless=true disables the web UI; leave false to keep the UI via Caddy.
SLSKD_HEADLESS=false
SLSKD_REMOTE_CONFIGURATION=true
SLSKD_REMOTE_FILE_MANAGEMENT=true
