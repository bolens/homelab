# Explo - copy to stack.env and set required values.
# Docs: https://github.com/LumePart/Explo/wiki
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# --- Scheduling (cron in container timezone) ---
WEEKLY_EXPLORATION_SCHEDULE=15 00 * * 2
WEEKLY_EXPLORATION_FLAGS=
# Optional additional jobs:
# WEEKLY_JAMS_SCHEDULE=30 00 * * 1
# WEEKLY_JAMS_FLAGS=--playlist=weekly-jams --download-mode=skip
# More frequent discovery example (every 4 hours):
DAILY_JAMS_SCHEDULE=15 */4 * * *
DAILY_JAMS_FLAGS=--playlist=daily-jams

# Optional startup run for testing:
# EXECUTE_ON_START=false
# START_FLAGS=--persist=false

# --- Discovery ---
LISTENBRAINZ_USER=REPLACE_WITH_YOUR_LISTENBRAINZ_USERNAME

# --- Music system target (navidrome, jellyfin, emby, plex, mpd, subsonic) ---
EXPLO_SYSTEM=navidrome
SYSTEM_URL=http://navidrome:4533
SYSTEM_USERNAME=REPLACE_WITH_SYSTEM_USERNAME
SYSTEM_PASSWORD=REPLACE_WITH_SYSTEM_PASSWORD
# Optional admin account for systems requiring privileged scan triggers:
# ADMIN_SYSTEM_USERNAME=
# ADMIN_SYSTEM_PASSWORD=
# Required for emby/jellyfin, optional for plex:
# API_KEY=
# Required for emby/jellyfin/plex:
# LIBRARY_NAME=Music
# Host path for the shared music library (should match Navidrome's /music bind).
MUSIC_LIBRARY_PATH=/mnt/unraid/media/music

# --- Download service ---
# Use both providers; Explo will query in priority order.
DOWNLOAD_SERVICES=youtube,slskd
YOUTUBE_API_KEY=REPLACE_WITH_YOUTUBE_API_KEY
# Optional: organize tracks in playlist-specific subfolders under /data.
USE_SUBDIRECTORY=true

# --- slskd integration / migration ---
# Host path where soulseek writes completed downloads (mounted to /slskd).
SLSKD_DOWNLOADS_PATH=/mnt/unraid/media/downloads/soulseek/
SLSKD_URL=http://soulseek:5030
SLSKD_API_KEY=REPLACE_WITH_SLSKD_API_KEY
MIGRATE_DOWNLOADS=true
# Prefer FLAC; allow MP3 fallback when FLAC isn't available.
EXTENSIONS=flac,mp3
# Optional: rename migrated files as artist-title.
RENAME_TRACK=true
SLSKD_DIR=/slskd/
