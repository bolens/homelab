# Joplin Server — split-horizon + public TLS: joplin.example.com and joplin-server.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

joplin.home, joplin-server.home, joplin.local, joplin-server.local {
	tls internal
	reverse_proxy joplin-server:22300 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://joplin.example.com {
	reverse_proxy joplin-server:22300 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

joplin.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy joplin-server:22300 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://joplin-server.example.com {
	reverse_proxy joplin-server:22300 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

joplin-server.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy joplin-server:22300 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
