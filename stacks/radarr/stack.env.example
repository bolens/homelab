# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000

# Optional: instance tuning
# RADARR__InstanceName=Radarr
# RADARR__BindAddress=*
# RADARR__Port=7878


# Unified media tree (host → /data). Libraries and downloads must share this
# mount so imports can use atomic moves/hardlinks instead of copying.
RADARR_MEDIA_PATH=/path/to/media
