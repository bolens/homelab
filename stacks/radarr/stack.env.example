# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)
PUID=1000
PGID=1000

# Optional: instance tuning
# RADARR__InstanceName=Radarr
# RADARR__BindAddress=*
# RADARR__Port=7878


# Media library bind mount (host → /movies in container)
RADARR_MOVIES_PATH=/path/to/media/movies

# Usenet downloads bind mount (host → /downloads; shared with NZBGet)
RADARR_USENET_DOWNLOADS_PATH=/path/to/media/downloads/usenet
