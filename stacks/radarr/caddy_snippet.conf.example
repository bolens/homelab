# Radarr — split-horizon + public TLS: radarr.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

radarr.home, radarr.local {
	tls internal
	reverse_proxy radarr:7878 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://radarr.example.com {
	reverse_proxy radarr:7878 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

radarr.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy radarr:7878 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
