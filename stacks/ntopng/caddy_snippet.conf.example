# ntopng — split-horizon + public TLS: ntopng.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).
# Upstream is published on the Docker host (same as LAN snippet).

ntopng.home, ntopng.local {
	tls internal
	reverse_proxy host.docker.internal:3000 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://ntopng.example.com {
	reverse_proxy host.docker.internal:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

ntopng.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy host.docker.internal:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
