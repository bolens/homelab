# Immich – copy to stack.env and set at least DB_PASSWORD and (if behind proxy) public URL.
# Full env reference: https://immich.app/docs/install/environment-variables

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Database password (A–Za–z0–9 only; no spaces). Generate with: openssl rand -hex 16 | tr -d '\n' | head -c 24
DB_PASSWORD=change-me-use-alphanumeric-only

# -----------------------------------------------------------------------------
# Version & paths
# -----------------------------------------------------------------------------

# Keep server and machine-learning on the same reviewed release tag.
IMMICH_VERSION=v3.3.5
# Machine-learning health probes use the shared internal telemetry network.
# Preparation creates it; the inference port is not published to the host.

# Optional finalized originals on an existing filesystem. Enable explicitly with
# docker-compose.storage.yml; the base stack uses named volumes.
# Verify the intended mount before creating this directory. Preparation never creates it.
# IMMICH_LIBRARY_PATH=/srv/media/photos/immich
# COMPOSE_FILE=docker-compose.yml:docker-compose.storage.yml
# Keep Storage Template enabled and hash verification on in Immich Administration.
# Each user's storage label (or user ID) becomes a subdirectory of this path.

# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# -----------------------------------------------------------------------------
# Reverse proxy
# -----------------------------------------------------------------------------
# Set the public URL / external domain in Administration → Settings (or in config file as server.externalDomain).

# -----------------------------------------------------------------------------
# Google OAuth (optional – can also be configured in Administration → Settings)
# -----------------------------------------------------------------------------
# To use a config file for OAuth and other options, mount the file and set:
# IMMICH_CONFIG_FILE=/path/inside/container/immich.json
# See README for Google OAuth setup (redirect URIs, issuer URL, client id/secret).

# -----------------------------------------------------------------------------
# Optional tuning (uncomment as needed)
# -----------------------------------------------------------------------------
# IMMICH_LOG_LEVEL=log
# IMMICH_ALLOW_SETUP=false
# DB_STORAGE_TYPE=HDD

# -----------------------------------------------------------------------------
# Do not change (used by this stack)
# -----------------------------------------------------------------------------
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
