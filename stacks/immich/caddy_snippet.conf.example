# Immich — split-horizon + public TLS: immich.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

immich.home, immich.local {
	tls internal
	reverse_proxy immich-server:2283 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://immich.example.com {
	reverse_proxy immich-server:2283 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

immich.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy immich-server:2283 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
