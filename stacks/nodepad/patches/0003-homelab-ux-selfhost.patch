 const STORAGE_KEY = "nodepad-ai-settings"
 
+/** Docker build args → client bundle; used when localStorage has no saved settings yet. */
+function envDefaultProvider(): AIProvider {
+  const v = (process.env.NEXT_PUBLIC_HOMELAB_DEFAULT_PROVIDER || "").trim().toLowerCase()
+  if (v === "ollama" || v === "openrouter" || v === "openai" || v === "zai") return v as AIProvider
+  return DEFAULT_PROVIDER
+}
+
+function envDefaultModelForProvider(p: AIProvider): string {
+  if (p === "ollama") {
+    return (process.env.NEXT_PUBLIC_HOMELAB_DEFAULT_OLLAMA_MODEL || "").trim() || DEFAULT_OLLAMA_MODEL_ID
+  }
+  return DEFAULT_MODEL_ID
+}
+
+function freshDefaults(): AISettings {
+  const p = envDefaultProvider()
+  return {
+    apiKey: "",
+    modelId: envDefaultModelForProvider(p),
+    webGrounding: false,
+    provider: p,
+    customBaseUrl: "",
+  }
+}
+
 function loadSettings(): AISettings {
   if (typeof window === "undefined") {
-    return { apiKey: "", modelId: DEFAULT_MODEL_ID, webGrounding: false, provider: DEFAULT_PROVIDER, customBaseUrl: "" }
+    return freshDefaults()
   }
   try {
     const raw = localStorage.getItem(STORAGE_KEY)
-    if (!raw) return { apiKey: "", modelId: DEFAULT_MODEL_ID, webGrounding: false, provider: DEFAULT_PROVIDER, customBaseUrl: "" }
-    return { apiKey: "", modelId: DEFAULT_MODEL_ID, webGrounding: false, provider: DEFAULT_PROVIDER, customBaseUrl: "", ...JSON.parse(raw) }
+    if (!raw) return freshDefaults()
+    return { ...freshDefaults(), ...JSON.parse(raw) }
   } catch {
-    return { apiKey: "", modelId: DEFAULT_MODEL_ID, webGrounding: false, provider: DEFAULT_PROVIDER, customBaseUrl: "" }
+    return freshDefaults()
   }
 }
 
