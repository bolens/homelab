+/** Prefer NODEPAD_SITE_URL for outbound fetch identity when self-hosting. */
+function contactOrigin(): string {
+  const raw = process.env.NODEPAD_SITE_URL?.trim()
+  if (!raw) return "https://nodepad.space"
+  try {
+    return new URL(raw).origin
+  } catch {
+    return "https://nodepad.space"
+  }
+}
