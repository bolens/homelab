+/** Self-hosted Umami script URL → origin for CSP. If unset, Umami is disabled (no cloud default in homelab). */
+function umamiOrigin() {
+  const u = process.env.UMAMI_SCRIPT_URL || ""
+  if (!u.trim()) return null
+  try {
+    return new URL(u).origin
+  } catch {
+    return null
+  }
+}
+
+function contentSecurityPolicy() {
+  const uo = umamiOrigin()
+  const scriptParts = ["'self'", "'unsafe-inline'", "'unsafe-eval'"]
+  const connectParts = [
+    "'self'",
+    "https://openrouter.ai",
+    "https://api.openai.com",
+    "https://api.z.ai",
+  ]
+  if (uo) {
+    scriptParts.push(uo)
+    connectParts.push(uo)
+  }
+  return [
+    "default-src 'self'",
+    `script-src ${scriptParts.join(" ")}`,
+    "style-src 'self' 'unsafe-inline'",
+    `connect-src ${connectParts.join(" ")}`,
+    "img-src 'self' data: blob: https://i.ytimg.com",
+    "font-src 'self' data:",
+    "frame-src https://www.youtube-nocookie.com https://www.youtube.com",
+    "frame-ancestors 'none'",
+  ].join("; ")
+}
+
