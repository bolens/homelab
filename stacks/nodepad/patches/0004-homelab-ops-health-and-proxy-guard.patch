@@ -4,7 +4,31 @@ export const runtime = "nodejs"
 
 const OLLAMA = (process.env.OLLAMA_ORIGIN || "http://ollama:11434").replace(/\/$/, "")
 
+/** Optional: comma-separated allowed Origin values for mutating Ollama proxy calls. */
+function originNotAllowed(req: NextRequest): boolean {
+  const raw = process.env.NODEPAD_ALLOWED_ORIGINS?.trim()
+  if (!raw) return false
+  const allowed = raw.split(",").map(s => s.trim()).filter(Boolean)
+  if (allowed.length === 0) return false
+  const mutating = req.method === "POST" || req.method === "PUT" || req.method === "PATCH" || req.method === "DELETE"
+  if (!mutating) return false
+  const origin = req.headers.get("origin") || ""
+  return !allowed.some(a => {
+    try {
+      return origin === new URL(a).origin
+    } catch {
+      return origin === a || origin.startsWith(a)
+    }
+  })
+}
+
 async function proxy(req: NextRequest, pathSegments: string[]) {
+  if (originNotAllowed(req)) {
+    return new Response(JSON.stringify({ error: "Origin not allowed for Ollama proxy" }), {
+      status: 403,
+      headers: { "content-type": "application/json" },
+    })
+  }
   const path = pathSegments.length ? pathSegments.join("/") : ""
   const search = new URL(req.url).search
   const target = `${OLLAMA}/${path}${search}`
