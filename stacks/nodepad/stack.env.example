########################################
# nodepad stack environment file
#
# Copy to stack.env (./prepare-stack.sh does this). Loaded into the container via
# docker-compose `env_file` — no symlink or project .env required for these keys.
#
# Optional NEXT_PUBLIC_* (client bundle): not read from this file at build time unless
# you pass build args, e.g.:
#   docker compose build --build-arg NEXT_PUBLIC_HOMELAB_DEFAULT_PROVIDER=ollama
#
# TZ/locale: ../../shared.env (see documents/SHARED-RESOURCES.md)
########################################

# --- Image (Portainer / registry: set image in compose or UI; default local tag below) ---
# Local compose uses image: nodepad:latest after build.

# --- Runtime (server / Next.js) — edit as needed ---
OLLAMA_ORIGIN=http://ollama:11434
# Public URL for OpenGraph / metadata (recommended behind Caddy):
# NODEPAD_SITE_URL=https://nodepad.example.com
# Self-hosted Umami (both required to enable; leave unset to disable):
# UMAMI_SCRIPT_URL=https://umami.example.com/script.js
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# Optional: lock Ollama proxy mutations to your site origin(s), comma-separated:
# NODEPAD_ALLOWED_ORIGINS=https://nodepad.example.com

# --- Optional client defaults (use docker compose build --build-arg, see header) ---
# NEXT_PUBLIC_HOMELAB_DEFAULT_PROVIDER=ollama
# NEXT_PUBLIC_HOMELAB_DEFAULT_OLLAMA_MODEL=llama3.2

# --- Optional server-side LiteLLM connection ---
# Require owner-only access to the WHOLE site, including /api/litellm, first.
# Origin checks alone do not authenticate callers. Never use NEXT_PUBLIC_* for keys.
# LITELLM_BASE_URL=http://litellm:4000/v1
# LITELLM_API_KEY=replace-with-model-restricted-inference-key
# LITELLM_ALLOWED_MODELS=gemini-flash-lite,copilot-sonnet,copilot-gemini
# Set NODEPAD_ALLOWED_ORIGINS or NODEPAD_SITE_URL above before enabling this key.
