# Tautulli — Plex monitoring and statistics.
# Copy to stack.env and adjust as needed.
# TZ/locale: use shared.env (see documents/SHARED-RESOURCES.md)

# File ownership — match your host user (run: id -u && id -g)
PUID=1000
PGID=1000

# Host paths for Tautulli config and data (absolute paths recommended for Portainer deploys)
TAUTULLI_CONFIG_PATH=/home/youruser/.config/tautulli
TAUTULLI_DATA_PATH=/home/youruser/.config/tautulli/data
