FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

LABEL org.opencontainers.image.title="rTorrent" \
      org.opencontainers.image.description="Current Alpine rTorrent for Flood" \
      org.opencontainers.image.source="https://github.com/rakshasa/rtorrent"

RUN apk add --no-cache ca-certificates rtorrent tzdata \
    && addgroup -g 1001 download \
    && adduser -D -H -u 1001 -G download download

USER 1001:1001
WORKDIR /home/download
ENTRYPOINT ["/usr/bin/rtorrent"]
