# Keep the existing session directory and socket path so upgrades preserve
# state and Flood remains compatible.

directory.default.set = /downloads
session.path.set = /home/download/.local/share/rtorrent/session
network.scgi.open_local = /home/download/.local/share/rtorrent/rtorrent.sock

# Peer port
network.port_range.set = 49160-49160
network.port_random.set = no

protocol.pex.set = yes
trackers.use_udp.set = yes
system.umask.set = 0002
