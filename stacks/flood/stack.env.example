# Optional container identity and locale defaults inherited by rTorrent and Flood.
PUID=1000
PGID=1000
UMASK=002
TZ=Etc/UTC
# Harbor fallback: FLOOD_RTORRENT_IMAGE=harbor.bolens.dev/homelab/flood-rtorrent:latest

# Optional dedicated Librarr downloads on an already verified mounted media root.
# FLOOD_LIBRARR_DOWNLOADS_PATH=/path/to/media/downloads/librarr
# LIBRARR_MEDIA_GID=1000
