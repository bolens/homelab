# Shlink — split-horizon + public TLS: short.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).
# LAN uses short.home / short.local.

short.home, short.local {
	tls internal
	reverse_proxy shlink:8080 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://short.example.com {
	reverse_proxy shlink:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

short.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy shlink:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
