# MeTube — split-horizon + public TLS: metube.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

metube.home, metube.local {
	tls internal
	reverse_proxy metube:8081 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://metube.example.com {
	reverse_proxy metube:8081 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

metube.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy metube:8081 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
