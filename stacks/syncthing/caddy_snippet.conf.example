# Syncthing — split-horizon + public TLS: syncthing.example.com (DNS-01; CLOUDFLARE_API_TOKEN in stacks/caddy/stack.env).

syncthing.home, syncthing.local {
	tls internal
	reverse_proxy syncthing:8384 {
		header_up Host {host}
		transport http {
			versions 1.1
		}
	}
}

http://syncthing.example.com {
	reverse_proxy syncthing:8384 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}

syncthing.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy syncthing:8384 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		transport http {
			versions 1.1
		}
	}
}
