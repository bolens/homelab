# Environment and secrets – do not commit
.env
.env.*
!.env.example
!.env.*.example

# Per-stack env files (Portainer / docker compose --env-file)
stack.env
stack.env.*
!stack.env.example
!stack.env.*.example

# Per-stack Caddy snippets (contain real hostname; .example templates are committed)
caddy_snippet.conf
!caddy_snippet.conf.example

# Shared env (TZ, locale) – copy from shared.env.example
shared.env

# Local .local hostnames list – copy from scripts/local-hosts.conf.example
scripts/local-hosts.conf

# LiteLLM proxy model list (generated from litellm_config.yaml.example by prepare-stack.sh)
stacks/litellm/litellm_config.yaml

# Config files that may contain secrets (keep .example templates)
config.yml
config.yaml
**/config.yml
**/config.yaml
**/loki-config.yml
**/promtail-config.yml
Caddyfile
**/Caddyfile
!**/*.example
!**/*.example.*

# Credentials and keys
credentials.json
cloudflared.json
tokens.txt
*.pem
*.key
*.crt
*.pfx
**/credentials/
**/secrets/

# ACME / Let's Encrypt (Traefik, Caddy, certbot – contain cert private keys & account key)
acme.json
**/acme.json
letsencrypt/
**/letsencrypt/

# Docker Compose overrides (often used for local secrets and host-specific config)
docker-compose.override.yml
docker-compose.*.local.yml
docker-compose.override.*.yml
/stacks/alicorn/
/stacks/nzbget/config/unpack-passwords.txt

# Auth and OAuth
.htpasswd
htpasswd
client_secret*.json
service-account*.json
*-credentials.json
.netrc
**/users.yaml
**/users.yml

# Registry / container auth
auth.json
config.json

# Database dumps and backups (can contain sensitive data)
*.sql
*.sql.gz
*.dump
backups/
**/backups/

# ASF config (ASF.json and bot configs may contain IPC password and Steam credentials)
stacks/archisteamfarm/config/

# VPN / WireGuard (configs contain private keys)
**/wireguard/**/*.conf
**/vpn/**/*.conf
wg*.conf

# SSH keys (if ever dropped in project)
id_rsa
id_ed25519

# Docker and runtime
.docker/
*.log
data/

# Harbor installer (large archive + extracted dir with generated configs)
stacks/harbor/harbor/
stacks/harbor/*.tgz

# PostHog hobby: ignore its upstream clone and generated artifacts while
# retaining the small homelab integration contract.
stacks/posthog/
!stacks/posthog/
stacks/posthog/*
!stacks/posthog/README.md
!stacks/posthog/caddy_snippet.conf.example
!stacks/posthog/clone-repo.sh
!stacks/posthog/docker-compose.homelab.yml
!stacks/posthog/docker-compose.yml
!stacks/posthog/logo.svg
!stacks/posthog/prepare-stack.sh
!stacks/posthog/stack.env.example
!stacks/posthog/stack.yaml
stacks/posthog/posthog/
stacks/posthog/docker-compose.base.yml
stacks/posthog/docker-compose.hobby.yml
stacks/posthog/dev-services.env
stacks/posthog/compose/
stacks/posthog/share/
stacks/posthog/posthog.merged.compose.yml

# OS and editor
.DS_Store
Thumbs.db
*.swp
*~
node_modules
.cursor/
.fallow/

# Python tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local operational output and downloaded datasets
.push-gitea-log.txt
geolite/

# Upstream working clones used to build or patch stacks; commit only the
# surrounding integration files, patches, and examples.
**/repo/
stacks/ail-framework/ail-framework-docker/

# pnpm (local store + virtual store; lockfile is committed)
.pnpm-store/
.pnpm-home/
**/.pnpm/
.pnpm-debug.log*

# Asking-NG is maintained as a separate nested repository.
stacks/asking-ng/
