{
  "name": "homelab-repository-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "lint:markdown": "node scripts/lint-markdown.mjs --config .markdownlint.json",
    "test:site": "playwright test",
