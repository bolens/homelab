    "test:markdown": "node --test scripts/test-lint-markdown.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "markdownlint": "0.41.1"
  },
  "overrides": {
    "micromark-extension-math@3.1.0": {
      "katex": "0.18.2"
    }
  }
}
